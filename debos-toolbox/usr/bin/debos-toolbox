    def page_drivers(self):
        body, actions = self.new_page("drivers")
        P = self.P
        c = self.card(body, "Detected Hardware")
        self.hw_text = self.label(c, self.t("loading"), "mono", fg=P["text"], wraplength=900, anchor="w")
        self.hw_text.pack(anchor="w", fill="x")
        self.hw_reco = self.label(c, "", "bold", fg=P["info"])
        self.hw_reco.pack(anchor="w", pady=(8, 0))
        c = self.card(body, "Drivers & Firmware",
                      "contrib, non-free and non-free-firmware are enabled automatically when needed.")
        self.drv_vars = {}
        colors = {"Proprietary": P["warning"], "Non-Free": P["warning"], "Open Source": P["success"], "Tool": P["info"], "System": P["info"]}
        self.drv_rows = {}
        for key, title, desc, cat in self.DRIVER_OPTIONS:
            v = tk.BooleanVar()
            self.drv_vars[key] = v
            self.drv_rows[key] = self.check(c, v, title, desc, [(cat, colors[cat])], style="Item.TCheckbutton")
        self.button(actions, "Apply Drivers", self.apply_drivers, "primary").pack(side="left")
        self.button(actions, "Hardware Report (inxi)", lambda: self.run_root("Hardware report", ["ensure_pkg inxi", "inxi -Fxxz"]), "secondary").pack(side="left", padx=8)

    def on_show_drivers(self):
        def work():
            lspci = run_cmd(["lspci"], timeout=10)
            lsusb = run_cmd(["lsusb"], timeout=10)
            pick = lambda text, pat: [re.sub(r"^\S+\s+", "", l) for l in text.splitlines() if re.search(pat, l, re.I)]
            cpu = next((l.split(":", 1)[1].strip() for l in read_file("/proc/cpuinfo").splitlines() if l.startswith("model name")), "Unknown")
            return {"CPU": [cpu], "GPU": pick(lspci, r"vga|3d|display"), "Network": pick(lspci, r"network|ethernet|wireless"),
                    "Audio": pick(lspci, r"audio"), "Bluetooth": pick(lsusb, r"bluetooth"), "_raw": lspci + "\n" + cpu}

        def done(hw):
            if isinstance(hw, Exception) or not self.hw_text.winfo_exists():
                return
            lines = []
            for key in ("CPU", "GPU", "Network", "Audio", "Bluetooth"):
                vals = hw.get(key) or ["not detected"]
                lines.append(f"{key + ':':<11}{vals[0]}")
                lines += [" " * 11 + v for v in vals[1:]]
            lines.append(f"{'Boot:':<11}{'UEFI' if os.path.isdir('/sys/firmware/efi') else 'Legacy BIOS'}, Secure Boot {'ON' if self.secure_boot else 'off'}")
            self.hw_text.config(text="\n".join(lines))
            raw = hw["_raw"].lower()
            reco = []
            gpu = " ".join(hw.get("GPU", [])).lower()
            if "nvidia" in gpu:
                reco.append("nvidia")
            if re.search(r"\bamd\b|ati|radeon", gpu):
                reco.append("amd")
            if "intel" in gpu:
                reco.append("intel")
            if "broadcom" in raw and re.search(r"network|wireless", raw):
                reco.append("broadcom")
            if re.search(r"realtek|intel.*(wireless|wi-fi)|atheros|qualcomm|mediatek", raw):
                reco.append("firmware")
            reco.append("microcode")
            for key in reco:
                row = self.drv_rows.get(key)
                if row:
                    tk.Label(row.winfo_children()[0], text=f" {self.t('recommended')} ", font=self.F["small"], fg="#FFFFFF", bg=self.P["accent"]).pack(side="left", padx=6)
            self.hw_reco.config(text="Recommended for this machine: " + ", ".join(dict.fromkeys(reco)))
        if not getattr(self, "_hw_scanned", False):
            self._hw_scanned = True
            self.in_thread(work, done)

    def apply_drivers(self):
        sel = [k for k, v in self.drv_vars.items() if v.get()]
        if not sel:
            return messagebox.showinfo(APP_NAME, self.t("nothing_selected"))
        cmds = ["backup_apt_sources", "enable_components", "apt_update"]
        if "i386" in sel:
            cmds += ["step 'Enabling 32-bit (i386) packages'", "dpkg --add-architecture i386", "apt_update",
                     "apt_install libgl1-mesa-dri:i386 libglx-mesa0:i386 mesa-vulkan-drivers:i386"]
        if "nvidia_detect" in sel:
            cmds += ["step 'nvidia-detect'", "ensure_pkg nvidia-detect", "nvidia-detect || true"]
        if "nvidia" in sel:
            cmds += ["step 'Installing the NVIDIA driver'",
                     "apt_install \"linux-headers-$(uname -r)\" || apt_install \"linux-headers-$ARCH\"",
                     "apt_install nvidia-kernel-dkms nvidia-driver firmware-misc-nonfree",
                     "[ -d /sys/firmware/efi ] && command -v mokutil >/dev/null && mokutil --sb-state 2>/dev/null | grep -q enabled && "
                     "warn 'Secure Boot is on: you may be asked to enroll a MOK key at next boot for the NVIDIA module.' || true"]
        if "nouveau" in sel:
            cmds += ["step 'Switching to Nouveau'",
                     "PKGS=$(dpkg-query -W -f='${Package}\\t${db:Status-Abbrev}\\n' | awk -F'\\t' '$2 ~ /^ii/ && $1 ~ /^(nvidia-|libnvidia-|xserver-xorg-video-nvidia)/ {print $1}')",
                     "[ -n \"$PKGS\" ] && apt-get purge -y $PKGS", "apt_install xserver-xorg-video-nouveau libgl1-mesa-dri",
                     "rm -f /etc/modprobe.d/nvidia-blacklists-nouveau.conf", "update-initramfs -u"]
        if "amd" in sel:
            cmds += ["step 'Installing AMD graphics stack'", "apt_install firmware-amd-graphics libgl1-mesa-dri libglx-mesa0 mesa-vulkan-drivers mesa-va-drivers xserver-xorg-video-amdgpu"]
        if "intel" in sel:
            cmds += ["step 'Installing Intel graphics stack'", "apt_install libgl1-mesa-dri libglx-mesa0 mesa-vulkan-drivers intel-media-va-driver-non-free firmware-misc-nonfree"]
        if "firmware" in sel:
            cmds += ["step 'Installing firmware'", "apt_install firmware-linux firmware-linux-nonfree firmware-iwlwifi firmware-realtek firmware-atheros firmware-misc-nonfree"]
        if "broadcom" in sel:
            cmds += ["step 'Installing Broadcom drivers'", "apt_install \"linux-headers-$(uname -r)\" broadcom-sta-dkms firmware-brcm80211",
                     "modprobe -r b44 b43 b43legacy ssb brcmsmac bcma 2>/dev/null || true", "modprobe wl || true"]
        if "microcode" in sel:
            cmds += ["step 'Installing CPU microcode'",
                     "if grep -q GenuineIntel /proc/cpuinfo; then apt_install intel-microcode; elif grep -q AuthenticAMD /proc/cpuinfo; then apt_install amd64-microcode; else warn 'No x86 microcode needed for this CPU.'; fi"]
        if "bluetooth" in sel:
            cmds += ["step 'Installing Bluetooth'", "apt_install bluez blueman", "systemctl enable --now bluetooth"]
        if "printing" in sel:
            cmds += ["step 'Installing printing support'", "apt_install cups printer-driver-all system-config-printer",
                     "systemctl enable --now cups", "usermod -aG lpadmin \"$TARGET_USER\""]
        if "scanner" in sel:
            cmds += ["step 'Installing scanner support'", "apt_install sane-utils simple-scan", "usermod -aG scanner \"$TARGET_USER\""]
        if "fwupd" in sel:
            cmds += ["step 'Firmware updates'", "ensure_pkg fwupd", "fwupdmgr refresh --force || true", "fwupdmgr get-updates || true",
                     "fwupdmgr update || true"]
        if "vulkan" in sel:
            cmds += ["apt_install vulkan-tools mesa-utils", "vulkaninfo --summary 2>/dev/null | head -n 30 || true"]
        cmds += ["ok 'Reboot to load new drivers and firmware.'"]
        self.run_root("Drivers & Hardware", cmds)

