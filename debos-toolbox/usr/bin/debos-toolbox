    def read_grub(self):
        vals = {}
        for line in read_file("/etc/default/grub").splitlines():
            m = re.match(r"^\s*(GRUB_[A-Z_]+)=(.*)$", line)
            if m:
                vals[m.group(1)] = m.group(2).strip().strip('"').strip("'")
        return vals

