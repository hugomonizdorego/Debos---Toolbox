# ---------------------------------------------------------------------------
# Bash helpers that are embedded at the top of every generated script
# ---------------------------------------------------------------------------
SCRIPT_HELPERS = r'''
set -E
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
FAILED=0
LOG_FILE=/var/log/debos-toolbox.log
if touch "$LOG_FILE" 2>/dev/null; then
    exec > >(tee -a "$LOG_FILE") 2>&1
fi
step() { echo -e "\n\e[1;34m==> $*\e[0m"; }
ok()   { echo -e "\e[1;32m[ OK ]\e[0m $*"; }
warn() { echo -e "\e[1;33m[WARN]\e[0m $*"; }
fail() { echo -e "\e[1;31m[FAIL]\e[0m $*"; FAILED=$((FAILED + 1)); }
trap 'rc=$?; fail "\"$BASH_COMMAND\" exited with code $rc"' ERR
apt_update()  { apt-get update || warn "apt-get update reported problems (see above)."; }
apt_install() { apt-get install -y "$@"; }
is_installed() { dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -q 'ok installed'; }
ensure_pkg() {
    local p missing=()
    for p in "$@"; do is_installed "$p" || missing+=("$p"); done
    [ ${#missing[@]} -eq 0 ] && return 0
    apt-get install -y "${missing[@]}"
}
add_key() {  # add_key <url> <destination .gpg>
    install -d -m 0755 "$(dirname "$2")"
    curl -fsSL "$1" | gpg --dearmor --yes -o "$2" && chmod 0644 "$2"
}
need_arch() {
    [ "$ARCH" = "$1" ] && return 0
    warn "This item is only available for $1 (this system is $ARCH) - skipped."
    return 1
}
enable_components() {
    step "Enabling contrib, non-free and non-free-firmware components"
    local f
    if [ -f /etc/apt/sources.list ]; then
        sed -i -E '/^[[:space:]]*deb(-src)?[[:space:]].*(debian\.org|\/debian(-security)?\/?[[:space:]])/ {
            / contrib( |$)/! s/ main( |$)/ main contrib\1/
            / non-free( |$)/! s/ contrib( |$)/ contrib non-free\1/
            / non-free-firmware( |$)/! s/ non-free( |$)/ non-free non-free-firmware\1/
        }' /etc/apt/sources.list
    fi
    for f in /etc/apt/sources.list.d/*.sources /etc/apt/sources.list.d/*.list; do
        [ -f "$f" ] || continue
        case "$f" in
            *.sources)
                grep -qE '^URIs:.*debian\.org|debian-archive-keyring' "$f" || continue
                sed -i -E '/^Components:/ {
                    / contrib( |$)/! s/$/ contrib/
                    / non-free( |$)/! s/$/ non-free/
                    / non-free-firmware( |$)/! s/$/ non-free-firmware/
                }' "$f" ;;
            *.list)
                sed -i -E '/^[[:space:]]*deb(-src)?[[:space:]].*debian\.org.*[[:space:]]main/ {
                    / contrib( |$)/! s/ main( |$)/ main contrib\1/
                    / non-free( |$)/! s/ contrib( |$)/ contrib non-free\1/
                    / non-free-firmware( |$)/! s/ non-free( |$)/ non-free non-free-firmware\1/
                }' "$f" ;;
        esac
    done
    ok "Components enabled."
}
backup_apt_sources() {
    local dest="/var/backups/debos-toolbox/apt-$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$dest"
    cp -a /etc/apt/sources.list /etc/apt/sources.list.d "$dest"/ 2>/dev/null || true
    ok "APT sources backed up to $dest"
}
'''

SCRIPT_FOOTER = r'''
trap - ERR
echo
if [ "$FAILED" -gt 0 ]; then
    echo -e "\e[1;31m[!] Finished with $FAILED problem(s). Review the output above or $LOG_FILE\e[0m"
else
    echo -e "\e[1;32m[✓] All tasks finished successfully.\e[0m"
fi
'''


# ---------------------------------------------------------------------------
# The GUI
# ---------------------------------------------------------------------------
try:
    import tkinter as tk
    from tkinter import ttk, messagebox, filedialog, font as tkfont
except ImportError:  # --version / --startup still work; main() explains how to fix it
    tk = None

try:
    from PIL import Image, ImageTk
except Exception:  # Pillow is optional; images are simply skipped
    Image = ImageTk = None


def load_settings():
    try:
        with open(CONFIG_FILE, encoding="utf-8") as fh:
            data = json.load(fh)
            if isinstance(data, dict):
                return data
    except Exception:
        pass
    return {}


def save_settings(data):
    try:
        os.makedirs(CONFIG_DIR, exist_ok=True)
        with open(CONFIG_FILE, "w", encoding="utf-8") as fh:
            json.dump(data, fh, indent=2)
    except Exception:
        pass


class DebosToolbox:
    def __init__(self, root):
        self.root = root
        self.settings = load_settings()
        self.lang = self.settings.get("language", "en")
        if self.lang not in STRINGS:
            self.lang = "en"
        self.theme = self.settings.get("theme", "light")
        if self.theme not in PALETTES:
            self.theme = "light"
        self.sys = detect_system()
        self.user, self.home = target_user()
        self.cpu_level = cpu_x86_level()
        self.secure_boot = secure_boot_enabled()
        self.images = {}
        self.current_page = "dashboard"
        self.status_var = tk.StringVar()
        self.results = queue.Queue()

        self.root.title(f"{APP_NAME} v{APP_VERSION}")
        self.root.geometry("1220x800")
        self.root.minsize(1000, 640)
        self.setup_fonts()
        self.set_window_icon()
        self.build_ui()
        self.poll_results()
        if not self.sys["has_apt"]:
            self.root.after(400, lambda: messagebox.showwarning(
                APP_NAME, "APT was not found. Debos - Toolbox is designed for Debian (Stable, Testing, Sid) and LMDE; most actions will not work on this system."))

    # ----- helpers --------------------------------------------------------
    def t(self, key):
        return STRINGS.get(self.lang, {}).get(key) or STRINGS["en"].get(key, key)

    @property
    def P(self):
        return PALETTES[self.theme]

    def setup_fonts(self):
        families = set(tkfont.families(self.root))
        sans = next((f for f in ("Inter", "Cantarell", "Noto Sans", "Ubuntu", "DejaVu Sans", "Liberation Sans") if f in families), "TkDefaultFont")
        mono = next((f for f in ("JetBrains Mono", "Noto Sans Mono", "DejaVu Sans Mono", "Liberation Mono") if f in families), "TkFixedFont")
        self.F = {
            "body": (sans, 10), "small": (sans, 9), "bold": (sans, 10, "bold"),
            "h1": (sans, 19, "bold"), "h2": (sans, 12, "bold"), "h3": (sans, 11, "bold"),
            "nav": (sans, 10), "navsec": (sans, 8, "bold"), "brand": (sans, 15, "bold"),
            "mono": (mono, 10), "stat": (sans, 15, "bold"),
        }

    def set_window_icon(self):
        try:
            if os.path.exists(ICON_PATH):
                self._icon = tk.PhotoImage(file=ICON_PATH)
                self.root.iconphoto(True, self._icon)
        except Exception:
            pass

    def load_image(self, path, size):
        key = (path, size)
        if key in self.images:
            return self.images[key]
        if Image is None or not os.path.exists(path):
            return None
        try:
            img = Image.open(path)
            img.thumbnail(size)
            self.images[key] = ImageTk.PhotoImage(img)
            return self.images[key]
        except Exception:
            return None

    def set_status(self, text):
        self.status_var.set(text)

    # ----- styles ----------------------------------------------------------
    def apply_style(self):
        P = self.P
        st = ttk.Style(self.root)
        if "clam" in st.theme_names():
            st.theme_use("clam")
        st.configure(".", background=P["surface"], foreground=P["text"], font=self.F["body"],
                     fieldbackground=P["input"], bordercolor=P["border"], lightcolor=P["border"],
                     darkcolor=P["border"], troughcolor=P["bg"], focuscolor=P["accent"])
        for name in ("TCheckbutton", "TRadiobutton"):
            st.configure(name, background=P["surface"], foreground=P["text"], font=self.F["body"],
                         indicatorbackground=P["input"], indicatorforeground=P["accent"])
            st.map(name, background=[("active", P["surface"])], foreground=[("disabled", P["muted"])],
                   indicatorbackground=[("selected", P["accent"]), ("active", P["select"])],
                   indicatorforeground=[("selected", "#FFFFFF")])
        st.configure("Item.TCheckbutton", font=self.F["h3"])
        st.configure("TEntry", fieldbackground=P["input"], foreground=P["text"], insertcolor=P["text"], padding=5)
        st.configure("TCombobox", fieldbackground=P["input"], foreground=P["text"], background=P["surface"],
                     arrowcolor=P["text"], padding=4)
        st.map("TCombobox", fieldbackground=[("readonly", P["input"])], foreground=[("readonly", P["text"])],
               selectbackground=[("readonly", P["input"])], selectforeground=[("readonly", P["text"])])
        st.configure("TNotebook", background=P["bg"], borderwidth=0, tabmargins=(0, 4, 0, 0))
        st.configure("TNotebook.Tab", background=P["secondary"], foreground=P["text"], padding=(16, 7), font=self.F["bold"], borderwidth=0)
        st.map("TNotebook.Tab", background=[("selected", P["accent"])], foreground=[("selected", P["accent_fg"])])
        st.configure("Vertical.TScrollbar", background=P["secondary"], troughcolor=P["bg"], arrowcolor=P["muted"], borderwidth=0)
        st.map("Vertical.TScrollbar", background=[("active", P["secondary_hover"])])
        self.root.option_add("*TCombobox*Listbox.background", P["input"])
        self.root.option_add("*TCombobox*Listbox.foreground", P["text"])
        self.root.option_add("*TCombobox*Listbox.selectBackground", P["accent"])
        self.root.option_add("*TCombobox*Listbox.selectForeground", P["accent_fg"])
        self.root.configure(bg=P["bg"])

    # ----- layout ----------------------------------------------------------
    def build_ui(self):
        for w in self.root.winfo_children():
            w.destroy()
        self.apply_style()
        P = self.P
        self.pages, self.nav_buttons = {}, {}
        self._install_scanned = self._hw_scanned = False

        # Sidebar
        side = tk.Frame(self.root, bg=P["sidebar"], width=232)
        side.pack(side="left", fill="y")
        side.pack_propagate(False)
        brand = tk.Frame(side, bg=P["sidebar"])
        brand.pack(fill="x", padx=18, pady=(18, 10))
        logo = self.load_image(ICON_PATH, (34, 34))
        if logo:
            tk.Label(brand, image=logo, bg=P["sidebar"]).pack(side="left", padx=(0, 10))
        bt = tk.Frame(brand, bg=P["sidebar"])
        bt.pack(side="left")
        tk.Label(bt, text="Debos", font=self.F["brand"], fg="#FFFFFF", bg=P["sidebar"]).pack(anchor="w")
        tk.Label(bt, text=f"Toolbox  v{APP_VERSION}", font=self.F["small"], fg=P["sidebar_muted"], bg=P["sidebar"]).pack(anchor="w")
        for sec, keys in NAV:
            tk.Label(side, text=self.t(sec), font=self.F["navsec"], fg=P["sidebar_muted"], bg=P["sidebar"]).pack(anchor="w", padx=20, pady=(12, 2))
            for key in keys:
                self.make_nav_button(side, key)

        # Main column
        main = tk.Frame(self.root, bg=P["bg"])
        main.pack(side="left", fill="both", expand=True)

        top = tk.Frame(main, bg=P["surface"], highlightthickness=0)
        top.pack(fill="x")
        tk.Frame(main, bg=P["border"], height=1).pack(fill="x")
        badge_color = {"sid": P["danger"], "testing": P["warning"], "stable": P["success"]}.get(self.sys["branch"], P["info"])
        tk.Label(top, text="●", fg=badge_color, bg=P["surface"], font=self.F["h3"]).pack(side="left", padx=(22, 6), pady=12)
        tk.Label(top, text=branch_badge(self.sys), fg=P["text"], bg=P["surface"], font=self.F["bold"]).pack(side="left", pady=12)
        tk.Label(top, text=f"   ·   {self.sys['arch']}   ·   {self.user}", fg=P["muted"], bg=P["surface"], font=self.F["body"]).pack(side="left")

        theme_txt = "☀  " + self.t("light") if self.theme == "dark" else "☾  " + self.t("dark")
        self.button(top, theme_txt, self.toggle_theme, "secondary").pack(side="right", padx=(6, 18), pady=10)
        self.lang_var = tk.StringVar(value=LANG_NAMES[self.lang])
        cb = ttk.Combobox(top, textvariable=self.lang_var, values=list(LANG_NAMES.values()), state="readonly", width=17)
        cb.pack(side="right", pady=10)
        cb.bind("<<ComboboxSelected>>", self.change_language)
        tk.Label(top, text=self.t("language") + ":", bg=P["surface"], fg=P["muted"], font=self.F["small"]).pack(side="right", padx=6)

        status = tk.Frame(main, bg=P["surface"])
        status.pack(side="bottom", fill="x")
        tk.Frame(main, bg=P["border"], height=1).pack(side="bottom", fill="x")
        self.status_var.set(self.t("ready"))
        tk.Label(status, textvariable=self.status_var, bg=P["surface"], fg=P["muted"], font=self.F["small"], anchor="w").pack(side="left", padx=18, pady=5)
        tk.Label(status, text=f"{APP_NAME} {APP_VERSION} (build {APP_BUILD})", bg=P["surface"], fg=P["muted"], font=self.F["small"]).pack(side="right", padx=18)

        self.content = tk.Frame(main, bg=P["bg"])
        self.content.pack(fill="both", expand=True, padx=26, pady=(18, 10))
        self.show_page(self.current_page)

    def make_nav_button(self, parent, key):
        P = self.P
        holder = tk.Frame(parent, bg=P["sidebar"])
        holder.pack(fill="x", padx=10, pady=1)
        bar = tk.Frame(holder, bg=P["sidebar"], width=3)
        bar.pack(side="left", fill="y")
        btn = tk.Label(holder, text=self.t("nav_" + key), font=self.F["nav"], fg=P["sidebar_fg"], bg=P["sidebar"],
                       anchor="w", padx=12, pady=7, cursor="hand2")
        btn.pack(side="left", fill="x", expand=True)
        btn.bind("<Button-1>", lambda e, k=key: self.show_page(k))
        btn.bind("<Enter>", lambda e, k=key: self.nav_hover(k, True))
        btn.bind("<Leave>", lambda e, k=key: self.nav_hover(k, False))
        self.nav_buttons[key] = (btn, bar)

    def nav_hover(self, key, inside):
        if key == self.current_page:
            return
        btn, _bar = self.nav_buttons[key]
        btn.config(bg=self.P["sidebar_hover"] if inside else self.P["sidebar"])

    def show_page(self, key):
        P = self.P
        self.current_page = key
        for k, (btn, bar) in self.nav_buttons.items():
            active = k == key
            btn.config(bg=P["sidebar_active"] if active else P["sidebar"], fg="#FFFFFF" if active else P["sidebar_fg"],
                       font=self.F["bold"] if active else self.F["nav"])
            bar.config(bg=P["accent"] if active else P["sidebar"])
        for page in self.pages.values():
            page.pack_forget()
        if key not in self.pages:
            getattr(self, "page_" + key)()
        self.pages[key].pack(fill="both", expand=True)
        hook = getattr(self, "on_show_" + key, None)
        if hook:
            hook()

    def change_language(self, _e=None):
        rev = {v: k for k, v in LANG_NAMES.items()}
        self.lang = rev.get(self.lang_var.get(), "en")
        self.settings["language"] = self.lang
        save_settings(self.settings)
        self.build_ui()

    def toggle_theme(self):
        self.theme = "light" if self.theme == "dark" else "dark"
        self.settings["theme"] = self.theme
        save_settings(self.settings)
        self.build_ui()

    # ----- widgets ---------------------------------------------------------
    def new_page(self, key, scroll=True):
        P = self.P
        outer = tk.Frame(self.content, bg=P["bg"])
        self.pages[key] = outer
        head = tk.Frame(outer, bg=P["bg"])
        head.pack(fill="x", pady=(0, 12))
        tk.Label(head, text=self.t("nav_" + key), font=self.F["h1"], fg=P["text"], bg=P["bg"]).pack(anchor="w")
        tk.Label(head, text=self.t("sub_" + key), font=self.F["body"], fg=P["muted"], bg=P["bg"], justify="left", wraplength=850).pack(anchor="w", pady=(2, 0))
        actions = tk.Frame(outer, bg=P["bg"])
        actions.pack(side="bottom", fill="x", pady=(10, 0))
        body = self.scroll_area(outer) if scroll else tk.Frame(outer, bg=P["bg"])
        if not scroll:
            body.pack(fill="both", expand=True)
        return body, actions

    def scroll_area(self, parent, bg=None):
        bg = bg or self.P["bg"]
        wrap = tk.Frame(parent, bg=bg)
        wrap.pack(fill="both", expand=True)
        canvas = tk.Canvas(wrap, bg=bg, highlightthickness=0, bd=0)
        sb = ttk.Scrollbar(wrap, orient="vertical", command=canvas.yview)
        inner = tk.Frame(canvas, bg=bg)
        win = canvas.create_window((0, 0), window=inner, anchor="nw")
        inner.bind("<Configure>", lambda e: canvas.configure(scrollregion=canvas.bbox("all")))
        canvas.bind("<Configure>", lambda e: canvas.itemconfigure(win, width=e.width))
        canvas.configure(yscrollcommand=sb.set)
        canvas.pack(side="left", fill="both", expand=True)
        sb.pack(side="right", fill="y")

        def wheel(event):
            if canvas.yview() == (0.0, 1.0):
                return
            if getattr(event, "num", None) == 4:
                canvas.yview_scroll(-3, "units")
            elif getattr(event, "num", None) == 5:
                canvas.yview_scroll(3, "units")
            elif event.delta:
                canvas.yview_scroll(int(-event.delta / 40), "units")

        def bind(_e):
            canvas.bind_all("<Button-4>", wheel)
            canvas.bind_all("<Button-5>", wheel)
            canvas.bind_all("<MouseWheel>", wheel)

        def unbind(_e):
            canvas.unbind_all("<Button-4>")
            canvas.unbind_all("<Button-5>")
            canvas.unbind_all("<MouseWheel>")

        wrap.bind("<Enter>", bind)
        wrap.bind("<Leave>", unbind)
        inner.canvas = canvas
        return inner

    def card(self, parent, title=None, subtitle=None, side=None, expand=False):
        P = self.P
        outer = tk.Frame(parent, bg=P["surface"], highlightbackground=P["border"], highlightcolor=P["border"], highlightthickness=1)
        if side:
            outer.pack(side=side, fill="both", expand=expand, padx=(0, 12), pady=(0, 12))
        else:
            outer.pack(fill="x", pady=(0, 12), padx=(0, 6))
        inner = tk.Frame(outer, bg=P["surface"])
        inner.pack(fill="both", expand=True, padx=18, pady=14)
        if title:
            tk.Label(inner, text=title, font=self.F["h2"], fg=P["text"], bg=P["surface"]).pack(anchor="w")
        if subtitle:
            tk.Label(inner, text=subtitle, font=self.F["small"], fg=P["muted"], bg=P["surface"], justify="left", wraplength=820).pack(anchor="w", pady=(2, 8))
        elif title:
            tk.Frame(inner, bg=P["surface"], height=6).pack()
        return inner

    def button(self, parent, text, command, kind="primary"):
        P = self.P
        colors = {
            "primary": (P["accent"], P["accent_fg"], P["accent_hover"]),
            "secondary": (P["secondary"], P["text"], P["secondary_hover"]),
            "danger": (P["danger"], "#FFFFFF", P["danger_hover"]),
        }[kind]
        b = tk.Button(parent, text=text, command=command, bg=colors[0], fg=colors[1], activebackground=colors[2],
                      activeforeground=colors[1], relief="flat", bd=0, padx=14, pady=6, font=self.F["bold"],
                      cursor="hand2", highlightthickness=0)
        b.bind("<Enter>", lambda e: b.config(bg=colors[2]))
        b.bind("<Leave>", lambda e: b.config(bg=colors[0]))
        return b

    def button_row(self, parent, buttons, bg=None):
        row = tk.Frame(parent, bg=bg or self.P["surface"])
        row.pack(fill="x", pady=(4, 2))
        for spec in buttons:
            text, cmd = spec[0], spec[1]
            kind = spec[2] if len(spec) > 2 else "secondary"
            self.button(row, text, cmd, kind).pack(side="left", padx=(0, 8), pady=3)
        return row

    def check(self, parent, var, text, desc=None, badges=(), style="TCheckbutton"):
        P = self.P
        row = tk.Frame(parent, bg=P["surface"])
        row.pack(fill="x", pady=3)
        line = tk.Frame(row, bg=P["surface"])
        line.pack(fill="x")
        ttk.Checkbutton(line, text=text, variable=var, style=style).pack(side="left")
        for text_b, color in badges:
            tk.Label(line, text=f" {text_b} ", font=self.F["small"], fg="#FFFFFF", bg=color).pack(side="left", padx=(8, 0))
        if desc:
            tk.Label(row, text=desc, font=self.F["small"], fg=P["muted"], bg=P["surface"], justify="left", wraplength=780).pack(anchor="w", padx=(26, 0))
        return row

    def label(self, parent, text, kind="body", fg=None, **kw):
        P = self.P
        lbl = tk.Label(parent, text=text, font=self.F[kind], fg=fg or P["text"], bg=kw.pop("bg", P["surface"]), justify="left", **kw)
        return lbl

    def entry(self, parent, var, width=30):
        return ttk.Entry(parent, textvariable=var, width=width)

    def text_box(self, parent, height=12, mono=True):
        P = self.P
        txt = tk.Text(parent, height=height, font=self.F["mono" if mono else "body"], bg=P["input"], fg=P["text"],
                      insertbackground=P["text"], selectbackground=P["accent"], selectforeground="#FFFFFF",
                      relief="flat", bd=0, highlightthickness=1, highlightbackground=P["border"], highlightcolor=P["accent"],
                      padx=10, pady=8, wrap="none" if mono else "word", undo=True)
        return txt

    # ----- running privileged scripts --------------------------------------
    def build_script(self, title, cmds, pause=True):
        s = self.sys
        header = "\n".join([
            "#!/bin/bash",
            f"# Generated by {APP_NAME} {APP_VERSION} - {title}",
            f"TARGET_USER={shlex.quote(self.user)}",
            f"TARGET_HOME={shlex.quote(self.home)}",
            f"BRANCH={shlex.quote(s['branch'])}",
            f"DEBIAN_CODENAME={shlex.quote(s['debian_codename'] or STABLE_CODENAME)}",
            f"REPO_CODENAME={shlex.quote(s['repo_codename'])}",
            f"STABLE_CODENAME={STABLE_CODENAME}",
            "ARCH=$(dpkg --print-architecture 2>/dev/null || echo amd64)",
        ])
        body = "\n".join(cmds)
        banner = f"echo -e '\\e[1;35m{APP_NAME} {APP_VERSION}\\e[0m - {title.replace(chr(39), '')}'\necho \"Started: $(date)\"\ncd /tmp || exit 1"
        tail = SCRIPT_FOOTER
        if pause:
            tail += "read -rp $'\\nPress Enter to close this window...' _\n"
        else:
            tail += "sleep 3\n"
        tail += 'rm -f -- "$0"\n'
        return f"{header}\n{SCRIPT_HELPERS}\n{banner}\n\n{body}\n{tail}"

    def find_terminal(self):
        candidates = [
            ("x-terminal-emulator", ["-e"]), ("gnome-terminal", ["--"]), ("kgx", ["--"]), ("ptyxis", ["--"]),
            ("konsole", ["-e"]), ("xfce4-terminal", ["-x"]), ("mate-terminal", ["-x"]), ("tilix", ["-e"]),
            ("terminator", ["-x"]), ("qterminal", ["-e"]), ("lxterminal", ["-e"]), ("kitty", []),
            ("alacritty", ["-e"]), ("foot", []), ("xterm", ["-e"]),
        ]
        for binary, args in candidates:
            path = shutil.which(binary)
            if path:
                return [path] + args
        return None

    def run_root(self, title, cmds, pause=True, confirm=None):
        """Write cmds to a script and run it with root rights in a terminal."""
        if confirm and not messagebox.askyesno(APP_NAME, confirm):
            return False
        term = self.find_terminal()
        if not term:
            messagebox.showerror(APP_NAME, "No terminal emulator was found. Please install one, e.g.:\n\nsudo apt install xterm")
            return False
        script = self.build_script(title, cmds, pause)
        fd, path = tempfile.mkstemp(prefix="debos-", suffix=".sh")
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(script)
        os.chmod(path, 0o700)
        if os.geteuid() == 0:
            launcher = ["bash", path]
        elif shutil.which("sudo"):
            launcher = ["sudo", "bash", path]
        else:
            launcher = ["su", "-c", f"bash {shlex.quote(path)}"]
        try:
            subprocess.Popen(term + launcher, start_new_session=True)
        except Exception as exc:
            messagebox.showerror(APP_NAME, f"Could not start the terminal:\n{exc}")
            return False
        self.set_status(f"{self.t('terminal_opened')}: {title}")
        return True

    def run_user(self, title, cmds):
        """Run non-privileged commands in a terminal (still logged by sudo-less shell)."""
        term = self.find_terminal()
        if not term:
            messagebox.showerror(APP_NAME, "No terminal emulator was found.")
            return
        script = "#!/bin/bash\n" + "\n".join(cmds) + "\nread -rp $'\\nPress Enter to close this window...' _\nrm -f -- \"$0\"\n"
        fd, path = tempfile.mkstemp(prefix="debos-", suffix=".sh")
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(script)
        os.chmod(path, 0o700)
        subprocess.Popen(term + ["bash", path], start_new_session=True)
        self.set_status(f"{self.t('terminal_opened')}: {title}")

    def in_thread(self, work, done):
        """Run work() in a thread and deliver its result to done() on the Tk thread.

        Tk must only be touched from the main thread, so results travel through a
        queue that poll_results() drains with after()."""
        def runner():
            try:
                result = work()
            except Exception as exc:  # keep the GUI alive whatever happens
                result = exc
            self.results.put((done, result))
        threading.Thread(target=runner, daemon=True).start()

    def poll_results(self):
        try:
            while True:
                done, result = self.results.get_nowait()
                try:
                    done(result)
                except tk.TclError:
                    pass  # the widget was rebuilt (language/theme change) meanwhile
        except queue.Empty:
            pass
        self.root.after(100, self.poll_results)

    # =======================================================================
    # Dashboard
    # =======================================================================
    def page_dashboard(self):
        body, _actions = self.new_page("dashboard")
        P = self.P
        self.dash_stats = {}
        grid = tk.Frame(body, bg=P["bg"])
        grid.pack(fill="x")
        tiles = [("os", "Operating System"), ("branch", "Debian Branch"), ("kernel", "Kernel"), ("desktop", "Desktop"),
                 ("cpu", "Processor"), ("memory", "Memory"), ("disk", "Disk ( / )"), ("uptime", "Uptime"),
                 ("packages", "Packages"), ("updates", "Updates Available"), ("health", "Package Health"), ("secure", "Secure Boot")]
        for i, (key, title) in enumerate(tiles):
            tile = tk.Frame(grid, bg=P["surface"], highlightbackground=P["border"], highlightthickness=1)
            tile.grid(row=i // 4, column=i % 4, sticky="nsew", padx=(0, 10), pady=(0, 10))
            tk.Label(tile, text=title.upper(), font=self.F["navsec"], fg=P["muted"], bg=P["surface"]).pack(anchor="w", padx=14, pady=(12, 0))
            val = tk.Label(tile, text="…", font=self.F["h3"], fg=P["text"], bg=P["surface"], justify="left", wraplength=210, anchor="w")
            val.pack(anchor="w", fill="x", padx=14, pady=(2, 12))
            tile.bind("<Configure>", lambda e, lbl=val: lbl.config(wraplength=max(e.width - 32, 80)))
            self.dash_stats[key] = val
        for c in range(4):
            grid.columnconfigure(c, weight=1, uniform="tiles")

        c = self.card(body, "Quick Actions", "Common maintenance tasks. Each one opens a terminal so you can follow the progress.")
        self.button_row(c, [
            ("Update & Upgrade", self.quick_upgrade, "primary"),
            ("Full Upgrade (dist-upgrade)", self.quick_full_upgrade),
            ("Fix Broken Packages", self.quick_fix),
            ("Clean System…", lambda: self.show_page("clean")),
            ("Refresh", self.on_show_dashboard),
        ])

        self.dash_note = self.card(body, "Branch Notes")
        self.label(self.dash_note, self.branch_advice(), "body", wraplength=850).pack(anchor="w")

    def branch_advice(self):
        b = self.sys["branch"]
        if self.sys["is_lmde"]:
            return ("You are running LMDE. Debian software and drivers work normally, but do not switch the Debian branch: "
                    "LMDE manages its own repositories. Third-party repositories use the Debian codename "
                    f"'{self.sys['repo_codename']}'.")
        if b == "sid":
            return ("Sid (unstable) receives packages first and can break. Recommended: install apt-listbugs and apt-listchanges "
                    "(Updates & Release page), always read what a full-upgrade wants to REMOVE, and keep Timeshift snapshots. "
                    f"Third-party repositories are configured for '{self.sys['repo_codename']}'.")
        if b == "testing":
            return ("Testing has no timely security support and may have broken dependencies during transitions. "
                    "Upgrade regularly with full-upgrade and keep snapshots. "
                    f"Third-party repositories are configured for '{self.sys['repo_codename']}'.")
        if b == "stable":
            return ("Debian Stable: the most reliable choice. Enable unattended security upgrades in Tweaks & Tools, "
                    "and use the Backports kernel if you need newer hardware support.")
        if b in ("oldstable", "oldoldstable"):
            return (f"You are on Debian {BRANCH_LABEL[b]} ({self.sys['debian_codename']}). A newer stable release ({STABLE_CODENAME}) "
                    "is available - see Updates & Release to upgrade safely.")
        return "This system was not recognized as Debian. Some features may not work as expected."

    def gather_dashboard(self):
        d = {}
        s = self.sys
        d["os"] = s["pretty"]
        d["branch"] = BRANCH_LABEL.get(s["branch"], "Unknown") + (f"  ({s['debian_codename']})" if s["debian_codename"] else "")
        d["kernel"] = os.uname().release
        d["desktop"] = (os.environ.get("XDG_CURRENT_DESKTOP") or os.environ.get("DESKTOP_SESSION") or "Unknown") + \
            f"  ({os.environ.get('XDG_SESSION_TYPE', 'x11')})"
        cpu = "Unknown"
        for line in read_file("/proc/cpuinfo").splitlines():
            if line.startswith("model name"):
                cpu = re.sub(r"\s+", " ", line.split(":", 1)[1].strip())
                break
        cores = os.cpu_count() or 1
        lvl = f", x86-64-v{self.cpu_level}" if self.cpu_level else ""
        d["cpu"] = f"{cpu}  ({cores} threads{lvl})"
        mem = {}
        for line in read_file("/proc/meminfo").splitlines():
            parts = line.split()
            if len(parts) >= 2:
                mem[parts[0].rstrip(":")] = int(parts[1]) * 1024
        if mem.get("MemTotal"):
            used = mem["MemTotal"] - mem.get("MemAvailable", 0)
            d["memory"] = f"{human_size(used)} / {human_size(mem['MemTotal'])}"
        du = shutil.disk_usage("/")
        d["disk"] = f"{human_size(du.used)} / {human_size(du.total)}  ({du.used * 100 // max(du.total, 1)}%)"
        try:
            secs = int(float(read_file("/proc/uptime", "0").split()[0]))
            d["uptime"] = f"{secs // 86400}d {secs % 86400 // 3600}h {secs % 3600 // 60}m"
        except Exception:
            d["uptime"] = "?"
        debs = len(installed_packages())
        fps = len(installed_flatpaks())
        d["packages"] = f"{debs} deb" + (f"  ·  {fps} flatpak" if fps else "")
        sim = run_cmd(["apt-get", "-s", "-o", "Debug::NoLocking=1", "dist-upgrade"], timeout=60)
        n = sum(1 for line in sim.splitlines() if line.startswith("Inst "))
        d["updates"] = f"{n} package(s)" if sim else "Unknown (run apt update)"
        d["health"] = "Problems found - run Repair" if run_cmd(["dpkg", "--audit"], timeout=30) else "OK"
        d["secure"] = "Enabled" if self.secure_boot else ("Disabled" if os.path.isdir("/sys/firmware/efi") else "Legacy BIOS")
        return d

    def on_show_dashboard(self):
        for lbl in self.dash_stats.values():
            lbl.config(text=self.t("loading"))
        self.in_thread(self.gather_dashboard, self.fill_dashboard)

    def fill_dashboard(self, data):
        if isinstance(data, Exception) or "dashboard" not in self.pages:
            return
        for key, val in data.items():
            lbl = self.dash_stats.get(key)
            if lbl and lbl.winfo_exists():
                color = self.P["text"]
                if key == "health":
                    color = self.P["success"] if val == "OK" else self.P["danger"]
                elif key == "updates" and val.startswith("0 "):
                    color = self.P["success"]
                lbl.config(text=val, fg=color)

    def quick_upgrade(self):
        self.run_root("Update & Upgrade", [
            "step 'Refreshing package lists'", "apt_update",
            "step 'Upgrading packages'", "apt-get upgrade -y",
            "if command -v flatpak >/dev/null; then step 'Updating Flatpaks'; flatpak update -y --noninteractive; fi",
        ])

    def quick_full_upgrade(self):
        self.run_root("Full Upgrade", [
            "step 'Refreshing package lists'", "apt_update",
            "step 'Full upgrade - read the list of packages to be REMOVED before confirming'",
            "apt-get full-upgrade",
            "step 'Removing packages that are no longer needed'", "apt-get autoremove --purge -y",
            "if command -v flatpak >/dev/null; then step 'Updating Flatpaks'; flatpak update -y --noninteractive; fi",
        ])

    def quick_fix(self):
        self.run_root("Fix Broken Packages", [
            "step 'Configuring interrupted packages'", "dpkg --configure -a",
            "step 'Fixing broken dependencies'", "apt-get --fix-broken install -y",
            "apt_update", "apt-get check && ok 'Package database is consistent.'",
        ])

    # =======================================================================
    # Clean system
    # =======================================================================
    CLEAN_OPTIONS = [
        ("autoremove", True, "Remove unused packages and old kernels", "apt-get autoremove --purge (keeps the running and newest kernel)."),
        ("apt_cache", True, "Clear APT package cache", "Downloaded .deb files in /var/cache/apt/archives."),
        ("rc_configs", True, "Purge residual configuration files", "Leftover configs from packages that were removed (dpkg state 'rc')."),
        ("journal", True, "Shrink system journal", "Keep only the last 7 days / 200 MB of systemd logs."),
        ("flatpak", True, "Remove unused Flatpak runtimes", "flatpak uninstall --unused."),
        ("thumbs", True, "Clear thumbnail cache", "~/.cache/thumbnails of your user (regenerated automatically)."),
        ("old_logs", False, "Delete rotated logs", "Compressed and rotated files in /var/log (*.gz, *.1, *.old)."),
        ("trash", False, "Empty your Trash", "~/.local/share/Trash - this cannot be undone."),
        ("tmp", False, "Clean old temporary files", "Files and empty folders in /tmp untouched for more than 7 days."),
        ("duplicates", False, "Find duplicate files in ~/Downloads", "Interactive fdupes session: you choose what to keep."),
        ("update_grub", False, "Update GRUB menu afterwards", "Regenerates the boot menu after kernels were removed."),
    ]

    def page_clean(self):
        body, actions = self.new_page("clean")
        self.cl_vars = {}
        c = self.card(body, "Cleaning Options", "Sizes are estimates calculated when the page opens.")
        self.clean_size_labels = {}
        for key, default, title, desc in self.CLEAN_OPTIONS:
            v = tk.BooleanVar(value=default)
            self.cl_vars[key] = v
            row = self.check(c, v, title, desc, style="Item.TCheckbutton")
            lbl = tk.Label(row.winfo_children()[0], text="", font=self.F["small"], fg=self.P["accent"], bg=self.P["surface"])
            lbl.pack(side="left", padx=10)
            self.clean_size_labels[key] = lbl
        self.button(actions, "Execute Cleaning", self.run_cleaning, "primary").pack(side="left")
        self.button(actions, self.t("select_all"), lambda: [v.set(True) for v in self.cl_vars.values()], "secondary").pack(side="left", padx=8)
        self.button(actions, self.t("clear"), lambda: [v.set(False) for v in self.cl_vars.values()], "secondary").pack(side="left")

    def on_show_clean(self):
        def work():
            sizes = {}
            sizes["apt_cache"] = dir_size("/var/cache/apt/archives")
            sizes["thumbs"] = dir_size(os.path.join(self.home, ".cache/thumbnails"))
            sizes["trash"] = dir_size(os.path.join(self.home, ".local/share/Trash"))
            out = run_cmd(["journalctl", "--disk-usage"], timeout=10)
            m = re.search(r"take up ([\d.]+)([KMGT]?)", out)
            if m:
                mult = {"": 1, "K": 1024, "M": 1024 ** 2, "G": 1024 ** 3, "T": 1024 ** 4}[m.group(2)]
                sizes["journal"] = float(m.group(1)) * mult
            old = 0
            for pattern in ("/var/log/*.gz", "/var/log/*.[0-9]", "/var/log/*.old", "/var/log/*/*.gz", "/var/log/*/*.[0-9]"):
                for f in glob.glob(pattern):
                    try:
                        old += os.path.getsize(f)
                    except OSError:
                        pass
            sizes["old_logs"] = old
            rc = run_cmd("dpkg -l | grep -c '^rc'", shell=True)
            sizes["rc_configs"] = f"{rc} package(s)" if rc else None
            return sizes

        def done(sizes):
            if isinstance(sizes, Exception):
                return
            for key, val in sizes.items():
                lbl = self.clean_size_labels.get(key)
                if lbl and lbl.winfo_exists() and val:
                    lbl.config(text=val if isinstance(val, str) else f"≈ {human_size(val)}")
        self.in_thread(work, done)

    def run_cleaning(self):
        v = {k: var.get() for k, var in self.cl_vars.items()}
        if not any(v.values()):
            return messagebox.showinfo(APP_NAME, self.t("nothing_selected"))
        cmds = ["BEFORE=$(df --output=avail -B1 / | tail -n1)"]
        if v["autoremove"]:
            cmds += ["step 'Removing unused packages and old kernels'", "apt-get autoremove --purge -y"]
        if v["apt_cache"]:
            cmds += ["step 'Clearing APT cache'", "apt-get clean"]
        if v["rc_configs"]:
            cmds += ["step 'Purging residual configuration files'",
                     "RC=$(dpkg -l | awk '/^rc/ {print $2}')",
                     "if [ -n \"$RC\" ]; then echo \"$RC\" | xargs dpkg --purge; else ok 'Nothing to purge.'; fi"]
        if v["journal"]:
            cmds += ["step 'Shrinking the systemd journal'", "journalctl --vacuum-time=7d --vacuum-size=200M"]
        if v["flatpak"]:
            cmds += ["if command -v flatpak >/dev/null; then step 'Removing unused Flatpak runtimes'; flatpak uninstall --unused -y --noninteractive; fi"]
        if v["thumbs"]:
            cmds += ["step 'Clearing thumbnail cache'", "rm -rf -- \"$TARGET_HOME/.cache/thumbnails/\"*"]
        if v["old_logs"]:
            cmds += ["step 'Deleting rotated logs'",
                     "find /var/log -type f \\( -name '*.gz' -o -regex '.*\\.[0-9]+' -o -name '*.old' \\) -delete"]
        if v["trash"]:
            cmds += ["step 'Emptying Trash'", "rm -rf -- \"$TARGET_HOME/.local/share/Trash/files/\"* \"$TARGET_HOME/.local/share/Trash/info/\"*"]
        if v["tmp"]:
            cmds += ["step 'Cleaning old files in /tmp'",
                     "find /tmp -mindepth 1 -xdev -type f -atime +7 ! -path '/tmp/.X11-unix/*' ! -path '/tmp/.ICE-unix/*' ! -path '/tmp/systemd-private-*' -delete 2>/dev/null || true",
                     "find /tmp -mindepth 1 -xdev -type d -empty -mtime +7 ! -name '.*-unix' ! -name 'systemd-private-*' -delete 2>/dev/null || true"]
        if v["duplicates"]:
            cmds += ["step 'Searching duplicates in ~/Downloads (you will be asked which files to keep)'",
                     "ensure_pkg fdupes",
                     "sudo -u \"$TARGET_USER\" fdupes -r -d \"$TARGET_HOME/Downloads\" || true"]
        if v["update_grub"]:
            cmds += ["if command -v update-grub >/dev/null; then step 'Updating GRUB'; update-grub; fi"]
        cmds += ["AFTER=$(df --output=avail -B1 / | tail -n1)",
                 "FREED=$(( (AFTER - BEFORE) / 1024 / 1024 ))",
                 "ok \"Free space change on /: ${FREED} MB\""]
        self.run_root("Clean System", cmds)

    # =======================================================================
    # Repair APT
    # =======================================================================
    REPAIR_OPTIONS = [
        ("dpkg", True, "Finish interrupted installations", "dpkg --configure -a"),
        ("broken", True, "Fix broken dependencies", "apt-get --fix-broken install"),
        ("locks", False, "Remove stale APT/dpkg locks", "Only removed when no apt/dpkg process is running."),
        ("dedupe", True, "Remove duplicate repository lines", "Removes exact duplicate 'deb' lines in .list files (deb822 .sources files are left untouched)."),
        ("keys", True, "Import missing repository keys (NO_PUBKEY)", "Fetches missing keys from keyserver.ubuntu.com and stores them in /etc/apt/trusted.gpg.d."),
        ("lists", False, "Rebuild package lists", "Deletes /var/lib/apt/lists and downloads them again (fixes 'Hash Sum mismatch')."),
        ("modernize", False, "Convert sources to the deb822 format", "Runs 'apt modernize-sources' (APT 3.0+, Debian 13 and newer). Backups are kept."),
        ("keyring", False, "Reinstall Debian archive keyring", "Fixes expired or missing official Debian signing keys."),
    ]

    def page_repair(self):
        body, actions = self.new_page("repair")
        c = self.card(body, "Repair Tasks", "Run the tasks you need. Backups of all APT source files are made first.")
        self.rp_vars = {}
        for key, default, title, desc in self.REPAIR_OPTIONS:
            v = tk.BooleanVar(value=default)
            self.rp_vars[key] = v
            self.check(c, v, title, desc, style="Item.TCheckbutton")
        self.button(actions, "Run Repair", self.run_repair, "primary").pack(side="left")

    def run_repair(self):
        v = {k: var.get() for k, var in self.rp_vars.items()}
        if not any(v.values()):
            return messagebox.showinfo(APP_NAME, self.t("nothing_selected"))
        cmds = ["backup_apt_sources"]
        if v["locks"]:
            cmds += ["step 'Checking for stale locks'",
                     "if pgrep -x 'apt|apt-get|dpkg|aptitude|unattended-upgr' >/dev/null; then warn 'A package manager is running - locks were NOT removed.'; else "
                     "rm -f /var/lib/dpkg/lock /var/lib/dpkg/lock-frontend /var/lib/apt/lists/lock /var/cache/apt/archives/lock; ok 'Locks removed.'; fi"]
        if v["dpkg"]:
            cmds += ["step 'Finishing interrupted installations'", "dpkg --configure -a"]
        if v["dedupe"]:
            cmds += ["step 'Removing duplicate repository lines'",
                     "for f in /etc/apt/sources.list /etc/apt/sources.list.d/*.list; do [ -f \"$f\" ] || continue; "
                     "awk '/^[[:space:]]*deb/ { key=$0; gsub(/[[:space:]]+/, \" \", key); if (seen[key]++) next } { print }' \"$f\" > \"$f.debos-tmp\" && "
                     "if ! cmp -s \"$f\" \"$f.debos-tmp\"; then cat \"$f.debos-tmp\" > \"$f\"; ok \"Cleaned $f\"; fi; rm -f \"$f.debos-tmp\"; done"]
        if v["keyring"]:
            cmds += ["step 'Reinstalling the Debian archive keyring'", "apt-get install --reinstall -y debian-archive-keyring"]
        if v["lists"]:
            cmds += ["step 'Rebuilding package lists'", "rm -rf /var/lib/apt/lists/*", "mkdir -p /var/lib/apt/lists/partial"]
        if v["modernize"]:
            cmds += ["step 'Converting sources to deb822'",
                     "if apt --help 2>/dev/null | grep -q modernize-sources || apt modernize-sources --help >/dev/null 2>&1; then apt modernize-sources -y || apt modernize-sources; else warn 'Your APT version has no modernize-sources (needs APT 3.0 / Debian 13+).'; fi"]
        if v["keys"]:
            cmds += ["step 'Looking for missing repository keys'",
                     "ensure_pkg gnupg dirmngr",
                     "export GNUPGHOME=$(mktemp -d)",
                     "apt-get update 2>&1 | tee /tmp/debos-apt-update.log >/dev/null || true",
                     "MISSING=$(grep -oE 'NO_PUBKEY [0-9A-F]+' /tmp/debos-apt-update.log | awk '{print $2}' | sort -u)",
                     "if [ -z \"$MISSING\" ]; then ok 'No missing keys.'; fi",
                     "for key in $MISSING; do echo \"Fetching $key\"; "
                     "if gpg --batch --keyserver hkps://keyserver.ubuntu.com --recv-keys \"$key\"; then gpg --batch --export \"$key\" > \"/etc/apt/trusted.gpg.d/debos-$key.gpg\" && ok \"Imported $key\"; else fail \"Could not fetch key $key\"; fi; done",
                     "rm -rf \"$GNUPGHOME\" /tmp/debos-apt-update.log"]
        cmds += ["step 'Refreshing package lists'", "apt_update"]
        if v["broken"]:
            cmds += ["step 'Fixing broken dependencies'", "apt-get --fix-broken install -y"]
        cmds += ["apt-get check && ok 'Package database is consistent.'"]
        self.run_root("Repair APT & Keys", cmds)

    # =======================================================================
    # Updates & Release (Stable / Testing / Sid)
    # =======================================================================
    def page_release(self):
        body, _actions = self.new_page("release")
        P = self.P
        s = self.sys
        c = self.card(body, "System Updates")
        self.label(c, f"Current system: {branch_badge(s)}", "bold").pack(anchor="w", pady=(0, 6))
        self.button_row(c, [
            ("Check for Updates", self.check_updates, "primary"),
            ("Update & Upgrade", self.quick_upgrade),
            ("Full Upgrade", self.quick_full_upgrade),
            ("Update Flatpaks", lambda: self.run_root("Update Flatpaks", ["ensure_pkg flatpak", "flatpak update -y --noninteractive"])),
        ])
        if s["branch"] in ("testing", "sid"):
            self.button_row(c, [("Install apt-listbugs & apt-listchanges", lambda: self.run_root(
                "apt-listbugs", ["apt_update", "apt_install apt-listbugs apt-listchanges", "ok 'apt-listbugs will now warn you about critical bugs before upgrades.'"]))])

        c = self.card(body, "Switch Debian Branch",
                      "Generate a clean deb822 'debian.sources' for Debian Stable, Testing or Sid. Upgrading (Stable → Testing → Sid) "
                      "is supported by Debian; downgrading is NOT. Third-party repositories are left untouched.")
        self.rel_branch = tk.StringVar(value=s["branch"] if s["branch"] in ("stable", "testing", "sid") else "stable")
        opts = tk.Frame(c, bg=P["surface"])
        opts.pack(anchor="w", pady=4)
        for val, text in (("stable", f"Stable  ({STABLE_CODENAME}, Debian {DEBIAN_RELEASES[STABLE_CODENAME]})"),
                          ("testing", f"Testing  ({TESTING_CODENAME})"),
                          ("sid", "Unstable  (sid)")):
            ttk.Radiobutton(opts, text=text, value=val, variable=self.rel_branch, command=self.update_release_preview).pack(side="left", padx=(0, 18))
        self.rel_alias = tk.BooleanVar(value=False)
        self.rel_nonfree = tk.BooleanVar(value=True)
        self.rel_src = tk.BooleanVar(value=False)
        self.rel_bpo = tk.BooleanVar(value=False)
        self.rel_listbugs = tk.BooleanVar(value=True)
        self.rel_mirror = tk.StringVar(value=DEBIAN_MIRROR)
        for var, text, desc in (
            (self.rel_alias, "Follow the rolling alias ('stable' / 'testing') instead of the codename",
             "With the alias your system automatically moves to the next release. With the codename it stays until you change it."),
            (self.rel_nonfree, "Include contrib, non-free and non-free-firmware", "Needed for most Wi-Fi firmware, NVIDIA drivers, Steam, codecs."),
            (self.rel_src, "Include source packages (deb-src)", None),
            (self.rel_bpo, "Enable backports (Stable only)", "Newer kernels and software, rebuilt for Stable."),
            (self.rel_listbugs, "Install apt-listbugs & apt-listchanges (Testing/Sid)", "Warns about critical bugs before they reach your system."),
        ):
            self.check(c, var, text, desc)
            var.trace_add("write", lambda *_: self.update_release_preview())
        mrow = tk.Frame(c, bg=P["surface"])
        mrow.pack(anchor="w", pady=6)
        self.label(mrow, "Mirror:").pack(side="left")
        cb = ttk.Combobox(mrow, textvariable=self.rel_mirror, width=45, values=[
            DEBIAN_MIRROR, "http://deb.debian.org/debian", "https://mirrors.kernel.org/debian", "https://ftp.debian.org/debian"])
        cb.pack(side="left", padx=8)
        cb.bind("<<ComboboxSelected>>", lambda e: self.update_release_preview())
        cb.bind("<KeyRelease>", lambda e: self.update_release_preview())
        self.rel_preview = self.text_box(c, height=14)
        self.rel_preview.pack(fill="x", pady=8)
        self.update_release_preview()
        self.button_row(c, [
            ("Apply & Upgrade", self.apply_release, "danger"),
            ("Open in APT Sources Editor", self.release_to_editor),
        ])

    def generate_debian_sources(self):
        branch = self.rel_branch.get()
        alias = self.rel_alias.get()
        comps = "main contrib non-free non-free-firmware" if self.rel_nonfree.get() else "main non-free-firmware"
        types = "deb deb-src" if self.rel_src.get() else "deb"
        mirror = self.rel_mirror.get().strip() or DEBIAN_MIRROR
        if branch == "sid":
            suites, security = ["sid"], None
        else:
            name = branch if alias else (STABLE_CODENAME if branch == "stable" else TESTING_CODENAME)
            suites = [name, f"{name}-updates"]
            if branch == "stable" and self.rel_bpo.get():
                suites.append(f"{name}-backports")
            security = f"{name}-security"
        lines = [f"# Debian {BRANCH_LABEL[branch]} - generated by {APP_NAME} {APP_VERSION}",
                 f"Types: {types}", f"URIs: {mirror}", f"Suites: {' '.join(suites)}", f"Components: {comps}",
                 f"Signed-By: {DEBIAN_KEYRING}"]
        if security:
            lines += ["", f"Types: {types}", f"URIs: {DEBIAN_SECURITY}", f"Suites: {security}", f"Components: {comps}",
                      f"Signed-By: {DEBIAN_KEYRING}"]
        return "\n".join(lines) + "\n"

    def update_release_preview(self):
        if not hasattr(self, "rel_preview") or not self.rel_preview.winfo_exists():
            return
        self.rel_preview.config(state="normal")
        self.rel_preview.delete("1.0", "end")
        self.rel_preview.insert("1.0", self.generate_debian_sources())

    def release_to_editor(self):
        content = self.rel_preview.get("1.0", "end-1c")
        self.show_page("sources")
        self.src_var.set("/etc/apt/sources.list.d/debian.sources")
        self.src_txt.delete("1.0", "end")
        self.src_txt.insert("1.0", content)
        self.set_status("Generated sources loaded into the editor - review, then Save.")

    def apply_release(self):
        s = self.sys
        target = self.rel_branch.get()
        if s["is_lmde"]:
            return messagebox.showerror(APP_NAME, "Switching the Debian branch is not supported on LMDE. LMDE manages its own repositories.")
        if s["id"] != "debian":
            if not messagebox.askyesno(APP_NAME, "This system does not identify itself as Debian. Continue anyway?"):
                return
        cur_rank = BRANCH_RANK.get(s["branch"], 2)
        if BRANCH_RANK[target] < cur_rank:
            if not messagebox.askyesno(APP_NAME, f"WARNING: moving from {BRANCH_LABEL.get(s['branch'])} to {BRANCH_LABEL[target]} is a DOWNGRADE.\n\n"
                                       "Debian does not support downgrades. Packages will stay at their newer versions until the target branch catches up, "
                                       "and mixing can break your system.\n\nDo you really want to continue?", icon="warning"):
                return
        content = self.rel_preview.get("1.0", "end-1c").strip() + "\n"
        fd, tmp = tempfile.mkstemp(prefix="debos-sources-")
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(content)
        os.chmod(tmp, 0o644)
        disable_re = r"(debian\.org|\/debian(-security)?\/?)[[:space:]].*[[:space:]]main([[:space:]]|$)"
        cmds = [
            "backup_apt_sources",
            "step 'Writing /etc/apt/sources.list.d/debian.sources'",
            f"install -m 0644 {shlex.quote(tmp)} /etc/apt/sources.list.d/debian.sources && rm -f {shlex.quote(tmp)}",
            "step 'Disabling old Debian entries in .list files (third-party repositories are kept)'",
            "for f in /etc/apt/sources.list /etc/apt/sources.list.d/*.list; do [ -f \"$f\" ] || continue; "
            f"sed -i -E '/^[[:space:]]*deb(-src)?[[:space:]].*{disable_re}/ s/^/# disabled by Debos: /' \"$f\"; done",
            "for f in /etc/apt/sources.list.d/*.sources; do [ -f \"$f\" ] || continue; [ \"$f\" = /etc/apt/sources.list.d/debian.sources ] && continue; "
            "if grep -qE '^URIs:.*debian\\.org' \"$f\"; then mv \"$f\" \"$f.disabled\"; warn \"Disabled $f\"; fi; done",
        ]
        if target in ("testing", "sid") and self.rel_listbugs.get():
            cmds += ["apt_update", "step 'Installing apt-listbugs and apt-listchanges'", "apt_install apt-listbugs apt-listchanges"]
        cmds += [
            "step 'Refreshing package lists'", "apt_update",
            "step 'Upgrading to the selected branch - review the summary carefully before answering Y'",
            "apt-get upgrade --without-new-pkgs",
            "apt-get full-upgrade",
            "apt-get autoremove --purge",
            "ok 'Done. Please reboot to start the new kernel and libraries.'",
        ]
        msg = (f"Switch to Debian {BRANCH_LABEL[target]} and run a full upgrade?\n\n"
               "• Make a backup or Timeshift snapshot first.\n• Your current sources are backed up to /var/backups/debos-toolbox.\n"
               "• The upgrade can take a long time and asks for confirmation in the terminal.")
        self.run_root(f"Switch to Debian {BRANCH_LABEL[target]}", cmds, confirm=msg)

    def check_updates(self):
        self.run_root("Check for Updates", [
            "apt_update", "step 'Upgradable packages'", "apt list --upgradable 2>/dev/null | tail -n +2",
            "if command -v flatpak >/dev/null; then step 'Flatpak updates'; flatpak remote-ls --updates 2>/dev/null || true; fi"])

    # =======================================================================
    # APT sources editor
    # =======================================================================
    def page_sources(self):
        body, actions = self.new_page("sources", scroll=False)
        P = self.P
        c = self.card(body)
        row = tk.Frame(c, bg=P["surface"])
        row.pack(fill="x")
        self.label(row, "File:", "bold").pack(side="left")
        self.src_var = tk.StringVar(value="/etc/apt/sources.list.d/debian.sources" if os.path.exists("/etc/apt/sources.list.d/debian.sources") else "/etc/apt/sources.list")
        self.src_cb = ttk.Combobox(row, textvariable=self.src_var, width=60)
        self.src_cb.pack(side="left", padx=8)
        self.src_cb.bind("<<ComboboxSelected>>", lambda e: self.load_sources())
        self.button(row, "Load", self.load_sources, "secondary").pack(side="left")
        self.src_txt = self.text_box(body, height=20)
        self.src_txt.pack(fill="both", expand=True, pady=(0, 6))
        self.button(actions, "Save File", self.save_sources, "primary").pack(side="left")
        self.button(actions, "apt update", lambda: self.run_root("apt update", ["apt_update"]), "secondary").pack(side="left", padx=8)
        self.button(actions, "Enable contrib / non-free", lambda: self.run_root("Enable components", ["backup_apt_sources", "enable_components", "apt_update"]), "secondary").pack(side="left")
        self.button(actions, "Full Upgrade", self.quick_full_upgrade, "danger").pack(side="left", padx=8)
        self.load_sources()

    def on_show_sources(self):
        self.src_cb["values"] = apt_source_files() + ["/etc/apt/sources.list.d/debian.sources"]

    def load_sources(self):
        path = self.src_var.get()
        self.src_txt.delete("1.0", "end")
        if os.path.exists(path):
            self.src_txt.insert("1.0", read_file(path, f"# Could not read {path}\n"))
        else:
            self.src_txt.insert("1.0", f"# {path} does not exist yet.\n# Add repository entries here and click 'Save File' to create it.\n")

    def save_sources(self):
        path = self.src_var.get().strip()
        if not re.match(r"^/etc/apt/(sources\.list|sources\.list\.d/[A-Za-z0-9._-]+\.(list|sources))$", path):
            return messagebox.showerror(APP_NAME, "Only /etc/apt/sources.list or files ending in .list / .sources inside /etc/apt/sources.list.d can be saved.")
        fd, tmp = tempfile.mkstemp(prefix="debos-sources-")
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            content = self.src_txt.get("1.0", "end-1c")
            fh.write(content if content.endswith("\n") else content + "\n")
        os.chmod(tmp, 0o644)
        q = shlex.quote(path)
        self.run_root(f"Save {path}", [
            "backup_apt_sources",
            f"install -D -m 0644 {shlex.quote(tmp)} {q} && rm -f {shlex.quote(tmp)} && ok 'Saved {path}'",
            "step 'Checking the new configuration'", "apt_update",
        ])

    # =======================================================================
    # Install software
    # =======================================================================
    def page_install(self):
        body, actions = self.new_page("install", scroll=False)
        P = self.P
        top = tk.Frame(body, bg=P["bg"])
        top.pack(fill="x", pady=(0, 6))
        tk.Label(top, text=self.t("search") + ":", bg=P["bg"], fg=P["text"], font=self.F["bold"]).pack(side="left")
        self.sw_filter = tk.StringVar()
        ent = ttk.Entry(top, textvariable=self.sw_filter, width=36)
        ent.pack(side="left", padx=8)
        self.sw_filter.trace_add("write", lambda *_: self.filter_software())
        self.sw_info = tk.Label(top, text="", bg=P["bg"], fg=P["muted"], font=self.F["small"])
        self.sw_info.pack(side="left", padx=10)

        nb = ttk.Notebook(body)
        nb.pack(fill="both", expand=True)
        t1 = tk.Frame(nb, bg=P["bg"])
        t2 = tk.Frame(nb, bg=P["bg"])
        nb.add(t1, text="  APT / Vendor Packages  ")
        nb.add(t2, text="  Flatpak (Flathub)  ")
        self.deb_vars, self.fp_vars, self.sw_rows = {}, {}, []
        self.sw_badges = {}

        sa = self.scroll_area(t1)
        for cat in CATS:
            items = [(k, v) for k, v in SOFTWARE.items() if v[3] == cat]
            if not items:
                continue
            c = self.card(sa, cat)
            for key, (icon, name, desc, _cat, pkg, _recipe) in sorted(items, key=lambda kv: kv[1][1].lower()):
                var = tk.BooleanVar()
                self.deb_vars[key] = var
                row = self.check(c, var, f"{icon}  {name}", desc, style="Item.TCheckbutton")
                self.sw_rows.append((row, c, f"{name} {desc} {cat}".lower()))
                self.sw_badges[("deb", pkg)] = row.winfo_children()[0]

        sf = self.scroll_area(t2)
        c0 = self.card(sf, "Flatpak Setup", "Flatpak and the Flathub repository are configured automatically when you install a Flatpak.")
        self.button_row(c0, [
            ("Set up Flatpak + Flathub", lambda: self.run_root("Flatpak setup", self.flatpak_setup_cmds(store_plugin=True))),
            ("Update all Flatpaks", lambda: self.run_root("Update Flatpaks", ["ensure_pkg flatpak", "flatpak update -y --noninteractive"])),
        ])
        for cat in CATS:
            items = [f for f in FLATPAKS if f[4] == cat]
            if not items:
                continue
            c = self.card(sf, cat)
            for app_id, icon, name, desc, _cat in sorted(items, key=lambda x: x[2].lower()):
                var = tk.BooleanVar()
                self.fp_vars[app_id] = var
                row = self.check(c, var, f"{icon}  {name}", f"{desc}  ({app_id})", style="Item.TCheckbutton")
                self.sw_rows.append((row, c, f"{name} {desc} {app_id} {cat}".lower()))
                self.sw_badges[("fp", app_id)] = row.winfo_children()[0]

        self.button(actions, "Install Selected", self.install_software, "primary").pack(side="left")
        self.button(actions, self.t("clear"), lambda: [v.set(False) for v in list(self.deb_vars.values()) + list(self.fp_vars.values())], "secondary").pack(side="left", padx=8)

    def on_show_install(self):
        if getattr(self, "_install_scanned", False):
            return
        self._install_scanned = True
        self.sw_info.config(text="Checking installed applications…")

        def done(result):
            if isinstance(result, Exception):
                return
            debs, fps = result
            count = 0
            for (kind, name), line in self.sw_badges.items():
                if not line.winfo_exists():
                    continue
                if (kind == "deb" and name in debs) or (kind == "fp" and name in fps):
                    tk.Label(line, text=f" ✓ {self.t('installed')} ", font=self.F["small"], fg="#FFFFFF", bg=self.P["success"]).pack(side="left", padx=8)
                    count += 1
            self.sw_info.config(text=f"{count} of the listed applications are already installed.")
        self.in_thread(lambda: (installed_packages(), installed_flatpaks()), done)

    def filter_software(self):
        q = self.sw_filter.get().strip().lower()
        visible_cards = set()
        for row, card, text in self.sw_rows:
            row.pack_forget()
        for row, card, text in self.sw_rows:
            if not q or q in text:
                row.pack(fill="x", pady=3)
                visible_cards.add(card)
        for row, card, text in self.sw_rows:
            outer = card.master
            if card in visible_cards:
                if not outer.winfo_ismapped():
                    outer.pack(fill="x", pady=(0, 12), padx=(0, 6))
            else:
                outer.pack_forget()

    def flatpak_setup_cmds(self, store_plugin=False):
        cmds = ["step 'Setting up Flatpak and Flathub'", "ensure_pkg flatpak",
                "flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo"]
        if store_plugin:
            cmds += ["is_installed gnome-software && apt_install gnome-software-plugin-flatpak || true",
                     "is_installed plasma-discover && apt_install plasma-discover-backend-flatpak || true",
                     "ok 'Flathub is ready. Log out and back in to see Flatpak apps in your menu.'"]
        return cmds

    def install_software(self):
        debs = [k for k, v in self.deb_vars.items() if v.get()]
        fps = [k for k, v in self.fp_vars.items() if v.get()]
        if not debs and not fps:
            return messagebox.showinfo(APP_NAME, self.t("nothing_selected"))
        cmds = ["step 'Refreshing package lists'", "apt_update", "ensure_pkg curl wget gpg ca-certificates"]
        for key in debs:
            icon, name, _d, _c, _p, recipe = SOFTWARE[key]
            cmds.append(f"step {shlex.quote('Installing ' + name)}")
            cmds += recipe
        if fps:
            cmds += self.flatpak_setup_cmds()
            cmds += ["step 'Installing Flatpak applications'",
                     f"flatpak install -y --noninteractive flathub {' '.join(shlex.quote(f) for f in fps)}"]
        self._install_scanned = False
        names = [SOFTWARE[k][1] for k in debs] + fps
        self.run_root("Install Software", cmds, confirm=f"Install {len(names)} item(s)?\n\n• " + "\n• ".join(names[:25]) + ("\n…" if len(names) > 25 else ""))

    # =======================================================================
    # Uninstall software
    # =======================================================================
    PROTECTED = {"apt", "dpkg", "bash", "coreutils", "systemd", "dbus", "sudo", "network-manager", "policykit-1", "polkitd",
                 "gnome-shell", "gnome-session", "gnome-control-center", "plasma-desktop", "plasma-workspace", "systemsettings",
                 "xfce4-session", "xfce4-panel", "xfce4-settings", "cinnamon", "mate-panel", "lxqt-session", "nautilus",
                 "dolphin", "thunar", "nemo", "caja", "pcmanfm", "debos-toolbox", "xdg-utils", "desktop-file-utils"}

    def page_uninstall(self):
        body, actions = self.new_page("uninstall", scroll=False)
        P = self.P
        top = tk.Frame(body, bg=P["bg"])
        top.pack(fill="x", pady=(0, 8))
        tk.Label(top, text=self.t("search") + ":", bg=P["bg"], fg=P["text"], font=self.F["bold"]).pack(side="left")
        self.un_filter = tk.StringVar()
        ttk.Entry(top, textvariable=self.un_filter, width=36).pack(side="left", padx=8)
        self.un_filter.trace_add("write", lambda *_: self.render_uninstall())
        self.un_info = tk.Label(top, text="", bg=P["bg"], fg=P["muted"], font=self.F["small"])
        self.un_info.pack(side="left", padx=10)
        outer = tk.Frame(body, bg=P["surface"], highlightbackground=P["border"], highlightthickness=1)
        outer.pack(fill="both", expand=True)
        self.un_list = self.scroll_area(outer, bg=P["surface"])
        self.un_items, self.u_vars = [], {}
        self.button(actions, "Uninstall Selected", self.uninstall_software, "danger").pack(side="left")
        self.button(actions, self.t("refresh"), self.refresh_uninstall, "secondary").pack(side="left", padx=8)

    def on_show_uninstall(self):
        if getattr(self, "un_cache", None):
            self.un_items = self.un_cache
            self.render_uninstall()
        elif not self.un_items:
            self.refresh_uninstall()

    def refresh_uninstall(self):
        for w in self.un_list.winfo_children():
            w.destroy()
        self.label(self.un_list, "Scanning installed applications…", fg=self.P["muted"]).pack(anchor="w", padx=14, pady=12)
        self.in_thread(self.scan_applications, self.uninstall_loaded)

    def scan_applications(self):
        apps = {}
        desktop_files = glob.glob("/usr/share/applications/*.desktop")
        names = {}
        for path in desktop_files:
            text = read_file(path)
            if re.search(r"^NoDisplay\s*=\s*true", text, re.M) or "[Desktop Entry]" not in text:
                continue
            m = re.search(r"^Name\s*=\s*(.+)$", text, re.M)
            names[path] = m.group(1).strip() if m else os.path.basename(path)
        paths = list(names)
        for i in range(0, len(paths), 150):
            out = run_cmd(["dpkg", "-S"] + paths[i:i + 150], timeout=60)
            for line in out.splitlines():
                if ": " not in line:
                    continue
                pkgs, path = line.split(": ", 1)
                for pkg in pkgs.split(","):
                    pkg = pkg.strip().split(":")[0]
                    if pkg and pkg not in self.PROTECTED:
                        apps.setdefault(("deb", pkg), set()).add(names.get(path.strip(), pkg))
        essential = run_cmd(["dpkg-query", "-W", "-f=${Package} ${Essential} ${Priority}\n"], timeout=20)
        for line in essential.splitlines():
            parts = line.split()
            if len(parts) >= 3 and (parts[1] == "yes" or parts[2] in ("required", "important")):
                apps.pop(("deb", parts[0]), None)
        if shutil.which("flatpak"):
            out = run_cmd(["flatpak", "list", "--app", "--columns=application,name"], timeout=20)
            for line in out.splitlines():
                parts = line.split("\t")
                if parts and parts[0]:
                    apps[("flatpak", parts[0])] = {parts[1] if len(parts) > 1 else parts[0]}
        return sorted(((kind, pkg, ", ".join(sorted(n))) for (kind, pkg), n in apps.items()), key=lambda x: x[2].lower())

    def uninstall_loaded(self, items):
        if isinstance(items, Exception):
            items = []
        self.un_items = self.un_cache = items
        old = {k: v.get() for k, v in self.u_vars.items()}
        self.u_vars = {(kind, pkg): tk.BooleanVar(value=old.get((kind, pkg), False)) for kind, pkg, _n in items}
        self.render_uninstall()

    def render_uninstall(self):
        if not hasattr(self, "un_list") or not self.un_list.winfo_exists():
            return
        for w in self.un_list.winfo_children():
            w.destroy()
        q = self.un_filter.get().strip().lower()
        shown = 0
        for kind, pkg, name in self.un_items:
            if q and q not in name.lower() and q not in pkg.lower():
                continue
            shown += 1
            row = tk.Frame(self.un_list, bg=self.P["surface"])
            row.pack(fill="x", padx=14, pady=2)
            ttk.Checkbutton(row, text=name, variable=self.u_vars[(kind, pkg)]).pack(side="left")
            tag = "Flatpak" if kind == "flatpak" else "APT"
            tk.Label(row, text=f"  {tag}: {pkg}", font=self.F["small"], fg=self.P["muted"], bg=self.P["surface"]).pack(side="left")
        if not self.un_items:
            self.label(self.un_list, "No removable applications found.", fg=self.P["muted"]).pack(anchor="w", padx=14, pady=12)
        self.un_info.config(text=f"{shown} of {len(self.un_items)} applications")

    def uninstall_software(self):
        sel = [k for k, v in self.u_vars.items() if v.get()]
        if not sel:
            return messagebox.showinfo(APP_NAME, self.t("nothing_selected"))
        debs = [p for k, p in sel if k == "deb"]
        fps = [p for k, p in sel if k == "flatpak"]
        cmds = []
        if debs:
            cmds += ["step 'Removing APT packages - check the list of removed packages before confirming'",
                     f"apt-get purge {' '.join(shlex.quote(d) for d in debs)}", "apt-get autoremove --purge"]
        if fps:
            cmds += ["step 'Removing Flatpak applications'",
                     f"flatpak uninstall -y --noninteractive {' '.join(shlex.quote(f) for f in fps)}",
                     "flatpak uninstall --unused -y --noninteractive"]
        if self.run_root("Uninstall Software", cmds, confirm=f"Remove {len(sel)} application(s)?\n\n" + "\n".join(p for _k, p in sel[:30])):
            for k in sel:
                self.u_vars[k].set(False)

    # =======================================================================
    # Desktops & window managers
    # =======================================================================
    def page_desktops(self):
        body, actions = self.new_page("desktops")
        P = self.P
        current = os.environ.get("XDG_CURRENT_DESKTOP", "unknown")
        c = self.card(body, "Desktop Environments",
                      f"Current session: {current}.  Full = complete Debian task with apps · Minimal = desktop with basic apps · "
                      "Core = bare desktop + login manager.  Remove purges matching packages (you confirm in the terminal).")
        self.de_vars = {}
        for name, cfg in DE_COMMANDS.items():
            row = tk.Frame(c, bg=P["surface"])
            row.pack(fill="x", pady=4)
            left = tk.Frame(row, bg=P["surface"], width=240)
            left.pack(side="left", fill="y")
            left.pack_propagate(False)
            self.label(left, f"🖥️ {name}", "h3").pack(anchor="w")
            self.label(left, cfg["desc"], "small", fg=P["muted"]).pack(anchor="w")
            v = tk.StringVar(value="none")
            self.de_vars[name] = v
            for txt, val in (("None", "none"), ("Full", "full"), ("Minimal", "minimal"), ("Core", "core"), ("Remove", "remove")):
                ttk.Radiobutton(row, text=txt, variable=v, value=val).pack(side="left", padx=6)

        c = self.card(body, "Window Managers", "Lightweight alternatives. Choose the session on your login screen after installing.")
        self.wm_vars = {}
        for name, cfg in WM_COMMANDS.items():
            row = tk.Frame(c, bg=P["surface"])
            row.pack(fill="x", pady=4)
            left = tk.Frame(row, bg=P["surface"], width=240)
            left.pack(side="left", fill="y")
            left.pack_propagate(False)
            self.label(left, f"🪟 {name}", "h3").pack(anchor="w")
            self.label(left, cfg["desc"], "small", fg=P["muted"]).pack(anchor="w")
            v = tk.StringVar(value="none")
            self.wm_vars[name] = v
            for txt, val in (("None", "none"), ("Install", "install"), ("Remove", "remove")):
                ttk.Radiobutton(row, text=txt, variable=v, value=val).pack(side="left", padx=6)
        self.button(actions, "Apply Changes", self.apply_desktops, "primary").pack(side="left")

    @staticmethod
    def purge_regex_cmd(regex):
        return (f"PKGS=$(dpkg-query -W -f='${{Package}}\\t${{db:Status-Abbrev}}\\n' | awk -F'\\t' '$2 ~ /^ii/ && $1 ~ /{regex}/ {{print $1}}')",
                "if [ -n \"$PKGS\" ]; then apt-get purge $PKGS; apt-get autoremove --purge; else ok 'Nothing to remove.'; fi")

    def apply_desktops(self):
        cmds, summary = [], []
        for name, v in self.de_vars.items():
            act = v.get()
            cfg = DE_COMMANDS[name]
            if act in ("full", "minimal", "core"):
                cmds += [f"step {shlex.quote(f'Installing {name} ({act})')}", f"apt_install {cfg[act]}", "systemctl set-default graphical.target"]
                summary.append(f"Install {name} ({act})")
            elif act == "remove":
                cmds += [f"step {shlex.quote(f'Removing {name}')}", *self.purge_regex_cmd(cfg["rm"])]
                summary.append(f"Remove {name}")
        for name, v in self.wm_vars.items():
            act = v.get()
            cfg = WM_COMMANDS[name]
            if act == "install":
                summary.append(f"Install {name}")
                if name == "qtile":
                    cmds += ["step 'Installing Qtile in /opt/qtile'",
                             "apt_install python3-venv python3-dev build-essential libpangocairo-1.0-0 libxkbcommon-dev xinit xterm",
                             "python3 -m venv /opt/qtile && /opt/qtile/bin/pip install --upgrade pip && /opt/qtile/bin/pip install 'qtile[widgets]' xcffib cairocffi",
                             "ln -sf /opt/qtile/bin/qtile /usr/local/bin/qtile",
                             "printf '[Desktop Entry]\\nName=Qtile\\nComment=Qtile Session\\nExec=/usr/local/bin/qtile start\\nType=Application\\nKeywords=wm;tiling\\n' > /usr/share/xsessions/qtile.desktop"]
                else:
                    cmds += [f"step {shlex.quote(f'Installing {name}')}", f"apt_install {cfg['pkgs']}"]
            elif act == "remove":
                summary.append(f"Remove {name}")
                if name == "qtile":
                    cmds += ["rm -rf /opt/qtile /usr/local/bin/qtile /usr/share/xsessions/qtile.desktop", "ok 'Qtile removed.'"]
                else:
                    cmds += [f"step {shlex.quote(f'Removing {name}')}", *self.purge_regex_cmd(cfg["rm"])]
        if not cmds:
            return messagebox.showinfo(APP_NAME, self.t("nothing_selected"))
        cmds = ["apt_update"] + cmds
        self.run_root("Desktops & Window Managers", cmds, confirm="Apply these changes?\n\n• " + "\n• ".join(summary))

    # =======================================================================
    # Kernels
    # =======================================================================
    def page_kernels(self):
        body, actions = self.new_page("kernels", scroll=False)
        P = self.P
        nb = ttk.Notebook(body)
        nb.pack(fill="both", expand=True)
        t1 = tk.Frame(nb, bg=P["bg"])
        t2 = tk.Frame(nb, bg=P["bg"])
        nb.add(t1, text="  Install Kernels  ")
        nb.add(t2, text="  Installed Kernels  ")

        sa = self.scroll_area(t1)
        lvl = f"x86-64-v{self.cpu_level}" if self.cpu_level else f"not x86-64 ({self.sys['arch']})"
        notes = f"Your CPU supports: {lvl}.   Running kernel: {os.uname().release}."
        if self.secure_boot:
            notes += "\n⚠ Secure Boot is ENABLED: third-party and self-compiled kernels are unsigned and will not boot unless you disable Secure Boot or sign them yourself."
        c = self.card(sa, "Available Kernels", notes)
        self.kernel_vars = {}
        for key, title, desc, level in KERNELS:
            v = tk.BooleanVar()
            self.kernel_vars[key] = v
            badges = []
            if level and self.cpu_level and level == self.cpu_level and key.startswith("xanmod-x64"):
                badges.append((self.t("recommended"), P["success"]))
            if level and self.cpu_level and level > self.cpu_level:
                badges.append(("CPU not supported", P["danger"]))
            if key == "debian_backports" and self.sys["branch"] != "stable":
                badges.append(("Stable only", P["warning"]))
            self.check(c, v, title, desc.replace("<stable>", self.sys["debian_codename"] or STABLE_CODENAME), badges, style="Item.TCheckbutton")

        top = tk.Frame(t2, bg=P["bg"])
        top.pack(fill="x", pady=8)
        self.k_curr = tk.Label(top, text="", font=self.F["bold"], fg=P["success"], bg=P["bg"])
        self.k_curr.pack(side="left")
        outer = tk.Frame(t2, bg=P["surface"], highlightbackground=P["border"], highlightthickness=1)
        outer.pack(fill="both", expand=True)
        self.k_list = self.scroll_area(outer, bg=P["surface"])
        self.k_del_vars = {}
        kb = tk.Frame(t2, bg=P["bg"])
        kb.pack(fill="x", pady=(8, 0))
        self.button(kb, "Remove Selected Kernels", self.remove_kernels, "danger").pack(side="left")
        self.button(kb, self.t("refresh"), self.refresh_kernels, "secondary").pack(side="left", padx=8)

        self.button(actions, "Install Selected Kernels", self.install_kernels, "primary").pack(side="left")
        self.button(actions, "Update GRUB", lambda: self.run_root("Update GRUB", ["update-grub"]), "secondary").pack(side="left", padx=8)

    def on_show_kernels(self):
        self.refresh_kernels()

    def refresh_kernels(self):
        P = self.P
        curr = os.uname().release
        self.k_curr.config(text=f"Running kernel: {curr}  (protected)")
        for w in self.k_list.winfo_children():
            w.destroy()
        self.k_del_vars.clear()
        out = run_cmd(["dpkg-query", "-W", "-f=${Package}\t${db:Status-Abbrev}\t${Version}\t${Installed-Size}\n", "linux-image-*"], timeout=20)
        rows = []
        for line in out.splitlines():
            parts = line.split("\t")
            if len(parts) < 4 or not parts[1].startswith("ii"):
                continue
            pkg, _st, ver, size = parts
            if not re.match(r"^linux-image-\d", pkg):
                continue  # meta packages (linux-image-amd64 ...) keep the system updated
            rows.append((pkg, ver, size))
        removable = 0
        for pkg, ver, size in sorted(rows, reverse=True):
            running = curr in pkg
            r = tk.Frame(self.k_list, bg=P["surface"])
            r.pack(fill="x", padx=14, pady=3)
            if running:
                tk.Label(r, text=f"● {pkg}", font=self.F["bold"], fg=P["success"], bg=P["surface"]).pack(side="left")
                tk.Label(r, text="  running", font=self.F["small"], fg=P["muted"], bg=P["surface"]).pack(side="left")
            else:
                v = tk.BooleanVar()
                self.k_del_vars[pkg] = v
                ttk.Checkbutton(r, text=pkg, variable=v).pack(side="left")
                removable += 1
            mb = int(size) // 1024 if size.isdigit() else 0
            tk.Label(r, text=f"   {ver}  ·  {mb} MB", font=self.F["small"], fg=P["muted"], bg=P["surface"]).pack(side="left")
        if not rows:
            self.label(self.k_list, "No versioned kernel packages found.", fg=P["muted"]).pack(anchor="w", padx=14, pady=12)
        elif not removable:
            self.label(self.k_list, "Only the running kernel is installed - nothing to remove.", fg=P["muted"]).pack(anchor="w", padx=14, pady=12)

    def remove_kernels(self):
        sel = [k for k, v in self.k_del_vars.items() if v.get()]
        if not sel:
            return messagebox.showinfo(APP_NAME, self.t("nothing_selected"))
        remaining = len(self.k_del_vars) - len(sel)
        warn = "" if remaining > 0 else "\n\nNote: only the running kernel will remain. Consider keeping one fallback kernel."
        pkgs = []
        for img in sel:
            pkgs.append(img)
            version = img[len("linux-image-"):].replace("-unsigned", "")
            pkgs.append(f"linux-headers-{version}")
        cmds = ["step 'Removing kernels'",
                "PKGS=''",
                f"for p in {' '.join(shlex.quote(p) for p in pkgs)}; do is_installed \"$p\" && PKGS=\"$PKGS $p\"; done",
                "apt-get purge -y $PKGS", "apt-get autoremove --purge -y",
                "if command -v update-grub >/dev/null; then update-grub; fi"]
        self.run_root("Remove Kernels", cmds, confirm=f"Remove {len(sel)} kernel(s)?\n\n" + "\n".join(sel) + warn)

    def install_kernels(self):
        sel = [k for k, v in self.kernel_vars.items() if v.get()]
        if not sel:
            return messagebox.showinfo(APP_NAME, self.t("nothing_selected"))
        cmds = ["apt_update", "ensure_pkg curl wget gpg ca-certificates"]
        xan = [k for k in sel if k.startswith("xanmod")]
        if "debian_backports" in sel:
            cmds += ["step 'Installing the Debian backports kernel'",
                     "if [ \"$BRANCH\" != stable ] && [ \"$BRANCH\" != oldstable ]; then warn 'Backports are only for Debian Stable/Oldstable - skipped.'; else "
                     "if ! grep -rqs \"$DEBIAN_CODENAME-backports\" /etc/apt/sources.list /etc/apt/sources.list.d/; then "
                     "printf 'Types: deb\\nURIs: https://deb.debian.org/debian\\nSuites: %s-backports\\nComponents: main contrib non-free non-free-firmware\\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\\n' \"$DEBIAN_CODENAME\" > /etc/apt/sources.list.d/debos-backports.sources; apt_update; fi; "
                     "apt-get install -y -t \"$DEBIAN_CODENAME-backports\" \"linux-image-$ARCH\" \"linux-headers-$ARCH\"; fi"]
        if xan:
            cmds += ["step 'Adding the XanMod repository'",
                     "need_arch amd64 && add_key https://dl.xanmod.org/archive.key /etc/apt/keyrings/xanmod-archive-keyring.gpg && "
                     "echo \"deb [signed-by=/etc/apt/keyrings/xanmod-archive-keyring.gpg] http://deb.xanmod.org $REPO_CODENAME main non-free\" > /etc/apt/sources.list.d/xanmod-release.list && "
                     "rm -f /etc/apt/sources.list.d/xanmod.list && apt_update"]
            for k in xan:
                cmds += [f"step 'Installing linux-{k}'", f"apt_install linux-{k}"]
        if "liquorix" in sel:
            cmds += ["step 'Installing Liquorix'",
                     "need_arch amd64 && curl -fsSL https://liquorix.net/install-liquorix.sh | bash"]
        if "linux-libre" in sel:
            cmds += ["step 'Installing Linux-libre (freesh)'",
                     "BASE=https://linux-libre.fsfla.org/pub/linux-libre/freesh/pool/main/f/freesh-archive-keyring/",
                     "KR=$(curl -fsSL \"$BASE\" | grep -oE 'freesh-archive-keyring_[0-9.]+_all\\.deb' | sort -uV | tail -n1)",
                     "if [ -n \"$KR\" ]; then wget -qO /tmp/freesh.deb \"$BASE$KR\" && apt_install /tmp/freesh.deb && apt_update && apt_install linux-libre; rm -f /tmp/freesh.deb; else fail 'Could not find the freesh keyring package.'; fi"]
        for moniker in ("stable", "longterm"):
            if f"mainline_{moniker}" in sel:
                cmds += self.mainline_cmds(moniker)
        cmds += ["if command -v update-grub >/dev/null; then step 'Updating GRUB'; update-grub; fi",
                 "ok 'Reboot and pick the new kernel from the GRUB menu (Advanced options).'"]
        msg = "Install the selected kernel(s)?"
        if self.secure_boot and any(k != "debian_backports" for k in sel):
            msg += "\n\n⚠ Secure Boot is enabled. These kernels are not signed by Debian and will be refused at boot until Secure Boot is disabled."
        self.run_root("Install Kernels", cmds, confirm=msg)

    def mainline_cmds(self, moniker):
        py = ("import sys,json; d=json.load(sys.stdin); "
              f"r=next(x for x in d['releases'] if x['moniker']=='{moniker}'); print(r['version'], r['source'])")
        return [
            f"step 'Building Linux mainline ({moniker}) from kernel.org - this can take a long time'",
            "ensure_pkg build-essential bc bison flex libssl-dev libelf-dev libncurses-dev dwarves rsync cpio kmod python3 xz-utils debhelper",
            f"read -r KVER KSRC < <(curl -fsSL https://www.kernel.org/releases.json | python3 -c {shlex.quote(py)})",
            "if [ -z \"$KSRC\" ]; then fail 'Could not read kernel.org release information.'; else",
            "  KBUILD=/usr/local/src/debos-kernel; mkdir -p \"$KBUILD\" && cd \"$KBUILD\"",
            "  echo \"Kernel $KVER: $KSRC\"",
            "  wget -c -O \"linux-$KVER.tar.xz\" \"$KSRC\" && rm -rf \"linux-$KVER\" && tar -xf \"linux-$KVER.tar.xz\" && cd \"linux-$KVER\"",
            "  cp \"/boot/config-$(uname -r)\" .config",
            "  scripts/config --disable SYSTEM_TRUSTED_KEYS --disable SYSTEM_REVOCATION_KEYS --set-str SYSTEM_TRUSTED_KEYS '' --set-str SYSTEM_REVOCATION_KEYS '' --disable DEBUG_INFO --enable DEBUG_INFO_NONE",
            "  make olddefconfig",
            "  if make -j\"$(nproc)\" bindeb-pkg LOCALVERSION=-debos; then",
            "    DEBS=(); for d in ../linux-image-*\"$KVER\"*debos*.deb ../linux-headers-*\"$KVER\"*debos*.deb; do case \"$d\" in *-dbg_*) ;; *) [ -f \"$d\" ] && DEBS+=(\"$d\") ;; esac; done",
            "    apt_install \"${DEBS[@]}\"",
            "    ok \"Kernel $KVER built and installed. Packages are in $KBUILD.\"",
            "  else fail 'Kernel build failed - see the output above.'; fi",
            "  cd /tmp",
            "fi",
        ]

