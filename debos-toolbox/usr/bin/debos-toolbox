    def page_tweaks(self):
        body, actions = self.new_page("tweaks")
        c = self.card(body, "System Tweaks")
        self.tw_vars = {}
        for key, title, desc, default in self.TWEAKS:
            v = tk.BooleanVar(value=default)
            self.tw_vars[key] = v
            self.check(c, v, title, desc, style="Item.TCheckbutton")
