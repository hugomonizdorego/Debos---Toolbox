        self.button(row, "Restore Original", lambda: self.mac_action("-p"), "secondary").pack(side="left")

    def on_show_network(self):
        try:
            ifaces = sorted(i for i in os.listdir("/sys/class/net") if i != "lo")
        except Exception:
            ifaces = []
        self.mac_cb["values"] = ifaces
        if ifaces and not self.iface_var.get():
            self.iface_var.set(ifaces[0])
        self.load_network(False)

    def load_network(self, public):
        self.net_info.config(text=self.t("loading"))

        def work():
            lines = []
            for line in run_cmd(["ip", "-o", "-4", "addr", "show"]).splitlines():
                parts = line.split()
                if len(parts) > 3 and parts[1] != "lo":
                    lines.append(f"{parts[1] + ':':<14}{parts[3]}")
            for line in run_cmd(["ip", "-o", "-6", "addr", "show", "scope", "global"]).splitlines():
                parts = line.split()
                if len(parts) > 3:
                    lines.append(f"{parts[1] + ':':<14}{parts[3]}")
            gw = run_cmd(["ip", "route", "show", "default"]).split("\n")[0]
            lines.append(f"{'Gateway:':<14}{gw or 'none'}")
            dns = [l.split()[1] for l in read_file("/etc/resolv.conf").splitlines() if l.startswith("nameserver") and len(l.split()) > 1]
            lines.append(f"{'DNS:':<14}{', '.join(dns) or 'unknown'}")
            if shutil.which("nmcli"):
                act = run_cmd(["nmcli", "-t", "-f", "NAME,TYPE,DEVICE", "connection", "show", "--active"])
                if act:
                    lines.append(f"{'Active:':<14}" + "; ".join(a.replace(":", " / ") for a in act.splitlines() if not a.endswith(":lo")))
            if public:
                ip = run_cmd(["curl", "-s", "--max-time", "6", "https://ifconfig.me"], timeout=8)
                lines.append(f"{'Public IP:':<14}{ip or 'unavailable'}")
            return "\n".join(lines) or "No network interfaces found."
        self.in_thread(work, lambda r: self.net_info.winfo_exists() and self.net_info.config(text=str(r)))

    def wifi_scan(self):
        self.run_root("Wi-Fi scan", [
            "ensure_pkg network-manager iw rfkill nmap",
            "rfkill unblock wifi || true",
            "step 'Available Wi-Fi networks'", "nmcli device wifi rescan 2>/dev/null; sleep 2; nmcli device wifi list",
            "step 'Hosts on your local network'",
            "IFACE=$(ip route show default | awk '{for(i=1;i<=NF;i++) if($i==\"dev\") print $(i+1)}' | head -n1)",
            "SUBNET=$(ip -o -4 addr show dev \"$IFACE\" 2>/dev/null | awk '{print $4}' | head -n1)",
            "if [ -n \"$SUBNET\" ]; then echo \"Scanning $SUBNET on $IFACE...\"; nmap -sn \"$SUBNET\"; else warn 'No active IPv4 network found.'; fi",
        ])

    def apply_dns(self):
        name = self.dns_var.get()
        v4, v6 = DNS_PRESETS.get(name, ("", ""))
        con = "CON=$(nmcli -t -f NAME,DEVICE connection show --active | grep -v ':lo$' | head -n1 | cut -d: -f1)"
        if v4:
            mod = (f"nmcli connection modify \"$CON\" ipv4.dns {shlex.quote(v4)} ipv4.ignore-auto-dns yes "
                   f"ipv6.dns {shlex.quote(v6)} ipv6.ignore-auto-dns yes")
        else:
            mod = "nmcli connection modify \"$CON\" ipv4.dns '' ipv4.ignore-auto-dns no ipv6.dns '' ipv6.ignore-auto-dns no"
        self.run_root(f"DNS: {name}", [
            "ensure_pkg network-manager", con,
            "if [ -z \"$CON\" ]; then fail 'No active NetworkManager connection.'; else",
            f"  {mod} && nmcli connection up \"$CON\" && ok \"DNS for '$CON' set to {name}.\"", "fi",
            "sleep 1; grep nameserver /etc/resolv.conf || true"])

    def change_hostname(self):
        name = self.host_var.get().strip().lower()
        if not re.match(r"^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$", name):
            return messagebox.showerror(APP_NAME, "Invalid hostname. Use letters, digits and hyphens (max 63 characters).")
        old = os.uname().nodename
        self.run_root("Change hostname", [
            f"hostnamectl set-hostname {name}",
            f"if grep -qE '^127\\.0\\.1\\.1' /etc/hosts; then sed -i -E 's/^127\\.0\\.1\\.1.*/127.0.1.1\\t{name}/' /etc/hosts; else echo -e '127.0.1.1\\t{name}' >> /etc/hosts; fi",
            f"ok 'Hostname changed from {old} to {name}.'"])

    def setup_rdp(self):
        self.run_root("RDP Server", [
            "apt_install xfce4 xfce4-goodies xrdp",
            "adduser xrdp ssl-cert 2>/dev/null || true",
            "echo 'xfce4-session' > /etc/skel/.xsession",
            "sudo -u \"$TARGET_USER\" sh -c 'echo xfce4-session > \"$HOME/.xsession\"'",
            "systemctl enable xrdp && systemctl restart xrdp",
            "command -v ufw >/dev/null && ufw allow 3389/tcp || true",
            "ok \"RDP server ready. Connect to $(hostname -I | awk '{print $1}'):3389 with Remmina or Windows Remote Desktop.\"",
            "warn 'Log out of your local session before connecting with the same user.'"],
            confirm="Install XFCE and the xrdp server and open port 3389?")

    def mac_action(self, flag):
        iface = self.iface_var.get()
        if not iface or not re.match(r"^[A-Za-z0-9_.:-]+$", iface):
            return messagebox.showwarning(APP_NAME, "Select a network interface first.")
        self.run_root("MAC changer", [
            "echo 'macchanger macchanger/automatically_run boolean false' | debconf-set-selections",
            "DEBIAN_FRONTEND=noninteractive ensure_pkg macchanger",
            f"ip link set dev {iface} down", f"macchanger {flag} {iface}", f"ip link set dev {iface} up"])

