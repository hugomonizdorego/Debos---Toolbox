        c = self.card(body, "Diagnostics & Logs")
        self.button_row(c, [
            ("Boot Errors", lambda: self.run_root("Boot errors", ["journalctl -b -p 3 --no-pager | tail -n 150"])),
            ("Failed Services", lambda: self.run_root("Failed services", ["systemctl --failed --no-pager"])),
            ("Boot Time", lambda: self.run_root("Boot time", ["systemd-analyze", "systemd-analyze blame --no-pager | head -n 25"])),
            ("Disk Usage", lambda: self.run_root("Disk usage", ["df -hT -x tmpfs -x devtmpfs", "step 'Largest folders in /var and your home'",
                                                                "du -xh --max-depth=1 /var \"$TARGET_HOME\" 2>/dev/null | sort -rh | head -n 20"])),
            ("Debos Log", lambda: self.run_root("Debos log", [f"tail -n 300 {LOG_FILE} 2>/dev/null || echo 'No log yet.'"])),
        ])
        self.button_row(c, [
