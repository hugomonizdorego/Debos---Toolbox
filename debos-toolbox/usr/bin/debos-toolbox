    def pick_file(self, var, types):
        path = filedialog.askopenfilename(initialdir=os.path.join(self.home, "Pictures") if os.path.isdir(os.path.join(self.home, "Pictures")) else self.home, filetypes=types)
        if path:
            var.set(path)

    def detect_dm(self):
        target = os.path.basename(os.path.realpath("/etc/systemd/system/display-manager.service"))
        return {"gdm.service": "GDM3", "gdm3.service": "GDM3", "sddm.service": "SDDM"}.get(
            target, "Slick-Greeter" if os.path.exists("/usr/sbin/slick-greeter") and target == "lightdm.service" else "LightDM GTK")

    def get_users(self):
        users = []
        try:
            for entry in pwd.getpwall():
                if 1000 <= entry.pw_uid < 60000 and entry.pw_shell not in ("/usr/sbin/nologin", "/bin/false"):
                    users.append(entry.pw_name)
        except Exception:
            pass
        return users

    def apply_grub(self):
        to = self.g_to.get().strip()
        if not to.isdigit():
            return messagebox.showerror(APP_NAME, "Timeout must be a whole number of seconds.")
        color_re = r"^[a-z-]+/[a-z-]+$"
        if not re.match(color_re, self.grub_color_normal.get()) or not re.match(color_re, self.grub_color_highlight.get()):
            return messagebox.showerror(APP_NAME, "Colors must look like 'white/black'.")

        def set_key(key, value):
            return (f"if grep -qE '^#?{key}=' /etc/default/grub; then sed -i -E 's|^#?{key}=.*|{key}={value}|' /etc/default/grub; "
                    f"else echo '{key}={value}' >> /etc/default/grub; fi")
        cmds = ["cp /etc/default/grub /etc/default/grub.debos.bak && ok 'Backup: /etc/default/grub.debos.bak'",
                set_key("GRUB_TIMEOUT", to),
                set_key("GRUB_TIMEOUT_STYLE", "hidden" if self.g_hid.get() else "menu"),
                set_key("GRUB_DISABLE_OS_PROBER", "false" if self.g_osp.get() else "true"),
                set_key("GRUB_COLOR_NORMAL", f'"{self.grub_color_normal.get()}"'),
                set_key("GRUB_COLOR_HIGHLIGHT", f'"{self.grub_color_highlight.get()}"')]
        if self.g_osp.get():
            cmds.append("ensure_pkg os-prober")
        if self.g_save.get():
            cmds += [set_key("GRUB_DEFAULT", "saved"), set_key("GRUB_SAVEDEFAULT", "true")]
        else:
            cmds += [set_key("GRUB_DEFAULT", "0"), "sed -i '/^GRUB_SAVEDEFAULT=/d' /etc/default/grub"]
        if self.g_quiet.get():
            cmds.append("grep -q '^GRUB_CMDLINE_LINUX_DEFAULT=.*quiet' /etc/default/grub || sed -i -E 's/^(GRUB_CMDLINE_LINUX_DEFAULT=\")/\\1quiet /' /etc/default/grub")
        else:
            cmds.append("sed -i -E '/^GRUB_CMDLINE_LINUX_DEFAULT=/ s/(\\\"| )quiet( |\\\")/\\1\\2/' /etc/default/grub")
        bg = self.g_bg.get().strip()
        if bg and bg.startswith("/boot/grub/"):
            pass  # already configured
        elif bg:
            if not os.path.isfile(bg):
                return messagebox.showerror(APP_NAME, f"Background image not found:\n{bg}")
            ext = os.path.splitext(bg)[1].lower().lstrip(".")
            if ext == "jpeg":
                ext = "jpg"
            if ext not in ("png", "jpg", "tga"):
                return messagebox.showerror(APP_NAME, "GRUB supports PNG, JPG and TGA images.")
            cmds += [f"cp {shlex.quote(bg)} /boot/grub/debos-background.{ext}", set_key("GRUB_BACKGROUND", f'"/boot/grub/debos-background.{ext}"')]
        else:
            cmds.append("sed -i '/^GRUB_BACKGROUND=/d' /etc/default/grub")
        cmds += ["step 'Regenerating GRUB configuration'", "update-grub"]
        self.run_root("GRUB settings", cmds)

    PLYMOUTH_SCRIPT = r'''wallpaper_image = Image("background.png");
screen_width = Window.GetWidth();
screen_height = Window.GetHeight();
wallpaper_sprite = Sprite(wallpaper_image.Scale(screen_width, screen_height));
wallpaper_sprite.SetZ(-100);
message_sprite = Sprite();
message_sprite.SetPosition(screen_width * 0.1, screen_height * 0.85, 10000);
fun password_callback(prompt, bullets) {
    text = prompt + "  ";
    for (i = 0; i < bullets; i++) text = text + "*";
    message_sprite.SetImage(Image.Text(text, 1, 1, 1));
}
Plymouth.SetDisplayPasswordFunction(password_callback);
fun question_callback(prompt, entry) {
    message_sprite.SetImage(Image.Text(prompt + "  " + entry, 1, 1, 1));
}
Plymouth.SetDisplayQuestionFunction(question_callback);
fun normal_callback() {
    message_sprite.SetImage(Image.Text("", 1, 1, 1));
}
Plymouth.SetDisplayNormalFunction(normal_callback);
fun message_callback(text) {
    message_sprite.SetImage(Image.Text(text, 1, 1, 1));
}
Plymouth.SetMessageFunction(message_callback);
'''

    def plymouth_finish_cmds(self, theme):
        return [
            f"plymouth-set-default-theme {theme}",
            "if [ -f /etc/default/grub ] && ! grep -q '^GRUB_CMDLINE_LINUX_DEFAULT=.*splash' /etc/default/grub; then "
            "cp /etc/default/grub /etc/default/grub.debos.bak; sed -i -E 's/^(GRUB_CMDLINE_LINUX_DEFAULT=\")/\\1splash /' /etc/default/grub; update-grub; fi",
            "step 'Rebuilding initramfs'", "update-initramfs -u",
            f"ok 'Plymouth theme {theme} is active. Reboot to see it.'"]

    def apply_plymouth(self):
        bg = self.plymouth_bg_path.get().strip()
        if not bg or not os.path.isfile(bg) or not bg.lower().endswith(".png"):
            return messagebox.showwarning(APP_NAME, "Please select a valid PNG image.")
        theme = re.sub(r"[^a-z0-9-]", "", self.plymouth_theme_name.get().strip().lower().replace(" ", "-")) or "debos-custom"
        d = f"/usr/share/plymouth/themes/{theme}"
        plymouth_file = "\\n".join(["[Plymouth Theme]", f"Name={theme}", "Description=Custom splash created by Debos - Toolbox",
                                    "ModuleName=script", "", "[script]", f"ImageDir={d}", f"ScriptFile={d}/{theme}.script"])
        cmds = [
            "step 'Installing Plymouth'", "apt_install plymouth plymouth-themes",
            f"rm -rf {d} && mkdir -p {d}",
            f"cp {shlex.quote(bg)} {d}/background.png && chmod 644 {d}/background.png",
            f"printf '{plymouth_file}\\n' > {d}/{theme}.plymouth",
            f"cat > {d}/{theme}.script <<'DEBOS_EOF'\n{self.PLYMOUTH_SCRIPT}DEBOS_EOF",
        ] + self.plymouth_finish_cmds(theme)
        self.run_root("Plymouth theme", cmds)

    def apply_existing_plymouth(self):
        theme = self.plymouth_existing.get()
        if theme.startswith("("):
            return self.run_root("Plymouth themes", ["apt_install plymouth plymouth-themes", "plymouth-set-default-theme -l"])
        if not re.match(r"^[A-Za-z0-9_.-]+$", theme or ""):
            return messagebox.showwarning(APP_NAME, "Select a theme.")
        self.run_root("Plymouth theme", ["ensure_pkg plymouth"] + self.plymouth_finish_cmds(theme))

    def switch_dm(self):
        dm = self.dm_target_var.get()
        pkg_map = {"GDM3": ("gdm3", "gdm3", "gdm"), "LightDM GTK": ("lightdm lightdm-gtk-greeter", "lightdm", "lightdm"),
                   "Slick-Greeter": ("lightdm slick-greeter", "lightdm", "lightdm"), "SDDM": ("sddm", "sddm", "sddm")}
        if dm not in pkg_map:
            return messagebox.showwarning(APP_NAME, "Please select a display manager.")
        pkgs, debconf_name, unit = pkg_map[dm]
        cmds = [
            f"step {shlex.quote('Installing ' + dm)}",
            f"echo '{debconf_name} shared/default-x-display-manager select {debconf_name}' | debconf-set-selections",
            f"DEBIAN_FRONTEND=noninteractive apt-get install -y {pkgs}",
            f"BIN=$(command -v {debconf_name} || echo /usr/sbin/{debconf_name})",
            "echo \"$BIN\" > /etc/X11/default-display-manager",
            f"DEBIAN_FRONTEND=noninteractive dpkg-reconfigure {debconf_name}",
            f"UNIT=$(systemctl cat {unit}.service >/dev/null 2>&1 && echo {unit}.service || echo {debconf_name}.service)",
            "ln -sf \"/lib/systemd/system/$UNIT\" /etc/systemd/system/display-manager.service",
            "systemctl daemon-reload",
        ]
        if dm == "Slick-Greeter":
            cmds += ["mkdir -p /etc/lightdm/lightdm.conf.d",
                     "printf '[Seat:*]\\ngreeter-session=slick-greeter\\n' > /etc/lightdm/lightdm.conf.d/40-debos-greeter.conf"]
        elif dm == "LightDM GTK":
            cmds += ["mkdir -p /etc/lightdm/lightdm.conf.d",
                     "printf '[Seat:*]\\ngreeter-session=lightdm-gtk-greeter\\n' > /etc/lightdm/lightdm.conf.d/40-debos-greeter.conf"]
        cmds += [f"ok {shlex.quote(dm + ' is now the default display manager. Reboot to use it.')}"]
        self.run_root(f"Switch to {dm}", cmds, confirm=f"Install {dm} and make it the default login screen?\nYou will need to reboot afterwards.")

    def apply_dm(self):
        dm = self.dm_target_var.get()
        if not dm:
            return messagebox.showwarning(APP_NAME, "Please select a display manager.")
        user = self.au_var.get()
        autologin = self.en_au.get() and bool(user)
        if user and not re.match(r"^[a-z_][a-z0-9_.-]*\$?$", user):
            return messagebox.showerror(APP_NAME, "Invalid user name.")
        gtk_theme, icon, font = self.dm_gtk.get().strip(), self.dm_ico.get().strip(), self.dm_fnt.get().strip()
        for val in (gtk_theme, icon, font):
            if not re.match(r"^[A-Za-z0-9 _.+-]*$", val):
                return messagebox.showerror(APP_NAME, f"Invalid value: {val}")
        cmds = []
        bg_target = ""
        bg = self.dm_bg.get().strip()
        if bg:
            if not os.path.isfile(bg):
                return messagebox.showerror(APP_NAME, f"Image not found:\n{bg}")
            ext = os.path.splitext(bg)[1].lower() or ".png"
            bg_target = f"/usr/share/backgrounds/debos/login{ext}"
            cmds += ["mkdir -p /usr/share/backgrounds/debos", f"install -m 0644 {shlex.quote(bg)} {bg_target}"]
        show = "true" if self.shw_usr.get() else "false"
        hide = "false" if self.shw_usr.get() else "true"

        if dm == "GDM3":
            conf = ["[org/gnome/login-screen]", f"disable-user-list={hide}", "", "[org/gnome/desktop/interface]"]
            if gtk_theme:
                conf.append(f"gtk-theme='{gtk_theme}'")
            if icon:
                conf.append(f"icon-theme='{icon}'")
            if font:
                conf.append(f"font-name='{font}'")
            if bg_target:
                conf += ["", "[org/gnome/desktop/background]", f"picture-uri='file://{bg_target}'", f"picture-uri-dark='file://{bg_target}'"]
            cmds += ["mkdir -p /etc/dconf/db/gdm.d /etc/dconf/profile",
                     "[ -f /etc/dconf/profile/gdm ] || printf 'user-db:user\\nsystem-db:gdm\\nfile-db:/usr/share/gdm/greeter-dconf-defaults\\n' > /etc/dconf/profile/gdm",
                     f"printf '%s\\n' {' '.join(shlex.quote(l) for l in conf)} > /etc/dconf/db/gdm.d/90-debos",
                     "dconf update",
                     "CONF=/etc/gdm3/daemon.conf; [ -f \"$CONF\" ] || CONF=/etc/gdm3/custom.conf",
                     "grep -q '^\\[daemon\\]' \"$CONF\" || echo '[daemon]' >> \"$CONF\"",
                     "sed -i -E '/^#?\\s*AutomaticLogin(Enable)?\\s*=/d' \"$CONF\""]
            if autologin:
                cmds.append(f"sed -i '/^\\[daemon\\]/a AutomaticLoginEnable=true\\nAutomaticLogin={user}' \"$CONF\"")
            if bg_target:
                cmds.append("warn 'Recent GNOME versions ignore custom login backgrounds; theme, icons and user list still apply.'")
        elif dm in ("LightDM GTK", "Slick-Greeter"):
            seat = ["[Seat:*]", f"greeter-hide-users={hide}"]
            if autologin:
                seat += [f"autologin-user={user}", "autologin-user-timeout=0"]
            cmds += ["mkdir -p /etc/lightdm/lightdm.conf.d",
                     f"printf '%s\\n' {' '.join(shlex.quote(l) for l in seat)} > /etc/lightdm/lightdm.conf.d/50-debos.conf"]
            if autologin:
                cmds.append("getent group autologin >/dev/null || groupadd -r autologin; " f"gpasswd -a {user} autologin")
            if dm == "LightDM GTK":
                greeter = ["[greeter]", f"theme-name={gtk_theme}", f"icon-theme-name={icon}", f"font-name={font}"]
                if bg_target:
                    greeter.append(f"background={bg_target}")
                cmds += ["mkdir -p /etc/lightdm/lightdm-gtk-greeter.conf.d",
                         f"printf '%s\\n' {' '.join(shlex.quote(l) for l in greeter)} > /etc/lightdm/lightdm-gtk-greeter.conf.d/50-debos.conf"]
            else:
                keys = {"theme-name": gtk_theme, "icon-theme-name": icon, "font-name": font}
                if bg_target:
                    keys["background"] = bg_target
                cmds += ["CONF=/etc/lightdm/slick-greeter.conf", "touch \"$CONF\"", "cp -n \"$CONF\" \"$CONF.debos.bak\" || true",
                         "grep -q '^\\[Greeter\\]' \"$CONF\" || echo '[Greeter]' >> \"$CONF\""]
                for k, val in keys.items():
                    if val:
                        cmds += [f"sed -i '/^{k}=/d' \"$CONF\"", f"sed -i '/^\\[Greeter\\]/a {k}={val}' \"$CONF\""]
        elif dm == "SDDM":
            conf = ["[Theme]", "Current=breeze"]
            if autologin:
                conf += ["", "[Autologin]", f"User={user}", "Session=$SESSION"]
            cmds += ["SESSION=$(for s in plasma plasmawayland plasmax11; do [ -f /usr/share/wayland-sessions/$s.desktop ] || [ -f /usr/share/xsessions/$s.desktop ] && { echo $s; break; }; done)",
                     "[ -n \"$SESSION\" ] || SESSION=$(basename \"$(ls /usr/share/wayland-sessions/*.desktop /usr/share/xsessions/*.desktop 2>/dev/null | head -n1)\" .desktop)",
                     "mkdir -p /etc/sddm.conf.d",
                     # user name is validated above, so an expanding heredoc is safe ($SESSION is filled in by bash)
                     "cat > /etc/sddm.conf.d/50-debos.conf <<DEBOS_EOF\n" + "\n".join(conf) + "\nDEBOS_EOF"]
            if bg_target:
                cmds += ["[ -d /usr/share/sddm/themes/breeze ] && printf '[General]\\nbackground=%s\\n' " f"{bg_target} > /usr/share/sddm/themes/breeze/theme.conf.user || warn 'Breeze SDDM theme not installed.'"]
            if show == "false":
                cmds.append("warn 'SDDM has no global option to hide the user list; set it in the SDDM theme instead.'")
        cmds.append("ok 'Login settings applied. Reboot or restart the display manager to see the changes.'")
        self.run_root("Login screen", cmds)

    # =======================================================================
    # About & License
    # =======================================================================
    def page_about(self):
        body, _actions = self.new_page("about")
        P = self.P
        c = self.card(body)
        top = tk.Frame(c, bg=P["surface"])
        top.pack(fill="x")
        logo = self.load_image(ICON_PATH, (96, 96))
        if logo:
            tk.Label(top, image=logo, bg=P["surface"]).pack(side="left", padx=(0, 18))
        info = tk.Frame(top, bg=P["surface"])
        info.pack(side="left", fill="x")
        self.label(info, APP_NAME, "h1").pack(anchor="w")
        self.label(info, f"Version {APP_VERSION}  ·  build {APP_BUILD}", "bold", fg=P["accent"]).pack(anchor="w")
        self.label(info, f"Developer: {AUTHOR}  ·  Timor-Leste", fg=P["muted"]).pack(anchor="w", pady=(4, 0))
        self.label(info, "All-in-one maintenance, software, driver, kernel, network and customization toolbox\n"
                         "for Debian Stable, Testing, Sid and LMDE.", fg=P["text"]).pack(anchor="w", pady=(6, 0))
        self.button_row(c, [
            ("GitHub Project", lambda: webbrowser.open(APP_URL), "primary"),
            ("Report an Issue", lambda: webbrowser.open(APP_URL + "/issues")),
            ("Debian", lambda: webbrowser.open("https://www.debian.org/")),
            ("FDSL - TL", lambda: webbrowser.open("https://www.fdsl.tl/")),
            ("Linux Foundation", lambda: webbrowser.open("https://www.linuxfoundation.org/")),
        ])
        self.label(c, "Credits: logic inspired by ubuntu-cleaner & iven.in; UI inspired by modern flat utility apps.", "small", fg=P["muted"]).pack(anchor="w", pady=(8, 0))

        c = self.card(body, "Settings")
        self.autostart_file = os.path.join(self.home, ".config/autostart/debos-toolbox.desktop")
        self.autostart_var = tk.BooleanVar(value=os.path.exists(self.autostart_file))
        ttk.Checkbutton(c, text="Background health monitor at login (broken packages, updates, low disk space)", variable=self.autostart_var, command=self.toggle_autostart).pack(anchor="w", pady=2)
        self.label(c, f"Settings file: {CONFIG_FILE}\nAction log: {LOG_FILE}", "small", fg=P["muted"]).pack(anchor="w", pady=(6, 0))

        c = self.card(body, "Send Feedback & Suggestions", "Opens your e-mail client with the message pre-filled.")
        f = tk.Frame(c, bg=P["surface"])
        f.pack(anchor="w", fill="x")
        self.fb_name, self.fb_email = tk.StringVar(), tk.StringVar()
        self.fb_distro = tk.StringVar(value=f"{self.sys['pretty']} [{BRANCH_LABEL.get(self.sys['branch'])}] - Debos {APP_VERSION}")
        for i, (lbl, var) in enumerate((("Name:", self.fb_name), ("Email:", self.fb_email), ("System:", self.fb_distro))):
            self.label(f, lbl).grid(row=i, column=0, sticky="w", pady=3)
            self.entry(f, var, 52).grid(row=i, column=1, sticky="w", padx=10)
        self.label(f, "Message:").grid(row=3, column=0, sticky="nw", pady=3)
        self.fb_msg = self.text_box(f, height=5, mono=False)
        self.fb_msg.configure(width=60)
        self.fb_msg.grid(row=3, column=1, sticky="w", padx=10, pady=3)
        self.button(f, "Send via Mail Client", self.send_feedback, "primary").grid(row=4, column=1, sticky="w", padx=10, pady=8)

    def toggle_autostart(self):
        try:
            if self.autostart_var.get():
                os.makedirs(os.path.dirname(self.autostart_file), exist_ok=True)
                with open(self.autostart_file, "w", encoding="utf-8") as fh:
                    fh.write("[Desktop Entry]\nType=Application\nExec=/usr/bin/debos-toolbox --startup\nHidden=false\nNoDisplay=false\n"
                             "X-GNOME-Autostart-enabled=true\nX-GNOME-Autostart-Delay=60\nName=Debos Health Monitor\n"
                             f"Comment=Checks system health at login\nIcon={ICON_PATH}\n")
            elif os.path.exists(self.autostart_file):
                os.remove(self.autostart_file)
            self.set_status("Health monitor " + ("enabled" if self.autostart_var.get() else "disabled"))
        except Exception as exc:
            messagebox.showerror(APP_NAME, f"Could not change autostart: {exc}")

    def send_feedback(self):
        name = self.fb_name.get().strip()
        msg = self.fb_msg.get("1.0", "end").strip()
        if not msg or not name:
            return messagebox.showwarning(APP_NAME, "Name and message are required.")
        body = urllib.parse.quote(f"Name: {name}\nEmail: {self.fb_email.get().strip()}\nSystem: {self.fb_distro.get().strip()}\n\nFeedback:\n{msg}")
        subject = urllib.parse.quote(f"Feedback for {APP_NAME} {APP_VERSION}")
        webbrowser.open(f"mailto:{AUTHOR_MAIL}?subject={subject}&body={body}")

