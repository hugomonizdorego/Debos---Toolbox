            ("Disable Firewall", lambda: self.run_root("Disable UFW", ["ufw disable"])),
            ("Status", lambda: self.run_root("UFW status", ["ensure_pkg ufw", "ufw status verbose"])),
            ("Install Gufw (GUI)", lambda: self.run_root("Gufw", ["apt_install gufw"])),
