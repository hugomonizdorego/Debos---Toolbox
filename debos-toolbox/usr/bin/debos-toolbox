def main():
    args = sys.argv[1:]
    if "--version" in args or "-v" in args:
        print(f"{APP_NAME} {APP_VERSION} (build {APP_BUILD})")
        return 0
    if "--help" in args or "-h" in args:
        print(f"{APP_NAME} {APP_VERSION}\n\nUsage: debos-toolbox [--startup | --version | --help]\n\n"
              "  --startup   run the background health check (used by autostart) and exit\n"
              "  --version   print the version and exit")
        return 0
    if "--startup" in args:
        startup_health_check()
        return 0
    if tk is None:
        print(f"{APP_NAME}: Tkinter is missing. Install it with: sudo apt install python3-tk", file=sys.stderr)
        return 1
    try:
        root = tk.Tk(className="debos-toolbox")
    except tk.TclError as exc:
        print(f"{APP_NAME}: cannot open a display ({exc}).", file=sys.stderr)
        return 1
    DebosToolbox(root)
    root.mainloop()
    return 0


if __name__ == "__main__":
    sys.exit(main())
