# ---------------------------------------------------------------------------
# Debian release knowledge
# ---------------------------------------------------------------------------
DEBIAN_RELEASES = {"bullseye": "11", "bookworm": "12", "trixie": "13", "forky": "14", "duke": "15"}
OLDOLDSTABLE_CODENAME = "bullseye"
OLDSTABLE_CODENAME = "bookworm"
STABLE_CODENAME = "trixie"
TESTING_CODENAME = "forky"
# Codenames that third-party vendors (Docker, WineHQ, XanMod, VirtualBox...) publish for.
THIRD_PARTY_CODENAMES = ("bookworm", "trixie")
BRANCH_RANK = {"oldoldstable": 0, "oldstable": 1, "stable": 2, "testing": 3, "sid": 4}
BRANCH_LABEL = {
    "oldoldstable": "Oldoldstable", "oldstable": "Oldstable", "stable": "Stable",
    "testing": "Testing", "sid": "Unstable (Sid)", "unknown": "Unknown",
}
DEBIAN_MIRROR = "https://deb.debian.org/debian"
DEBIAN_SECURITY = "https://security.debian.org/debian-security"
DEBIAN_KEYRING = "/usr/share/keyrings/debian-archive-keyring.gpg"


def run_cmd(args, timeout=10, shell=False):
    """Run a command and return stdout ('' on any failure). Never raises."""
    try:
        res = subprocess.run(args, capture_output=True, text=True, timeout=timeout, shell=shell)
        return res.stdout.strip()
    except Exception:
        return ""


def read_file(path, default=""):
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            return fh.read()
    except Exception:
        return default


def parse_os_release():
    data = {}
    for line in read_file("/etc/os-release").splitlines():
        if "=" in line and not line.startswith("#"):
            k, v = line.split("=", 1)
            data[k.strip()] = v.strip().strip('"').strip("'")
    return data


def apt_source_files():
    files = []
    if os.path.isfile("/etc/apt/sources.list"):
        files.append("/etc/apt/sources.list")
    files += sorted(glob.glob("/etc/apt/sources.list.d/*.list"))
    files += sorted(glob.glob("/etc/apt/sources.list.d/*.sources"))
    return files


def official_debian_suites():
    """Return the set of suites used by enabled official Debian repositories."""
    suites = set()
    debian_uri = re.compile(r"(debian\.org|/debian(-security)?/?$)")
    for path in apt_source_files():
        text = read_file(path)
        if path.endswith(".sources"):
            for stanza in re.split(r"\n\s*\n", text):
                fields = {}
                for line in stanza.splitlines():
                    if ":" in line and not line.lstrip().startswith("#"):
                        k, v = line.split(":", 1)
                        fields[k.strip().lower()] = v.strip()
                if fields.get("enabled", "yes").lower() == "no":
                    continue
                if "main" in fields.get("components", "").split() and any(debian_uri.search(u) for u in fields.get("uris", "").split()):
                    suites.update(fields.get("suites", "").split())
        else:
            for line in text.splitlines():
                parts = re.sub(r"\[[^\]]*\]", "", line).split()
                if len(parts) >= 4 and parts[0] in ("deb", "deb-src") and debian_uri.search(parts[1]) and "main" in parts[3:]:
                    suites.add(parts[2])
    return {s.split("-")[0] if s.split("-")[-1] in ("updates", "security", "backports", "proposed") else s for s in suites}


def detect_system():
    osr = parse_os_release()
    info = {
        "pretty": osr.get("PRETTY_NAME", "Unknown Linux"),
        "id": osr.get("ID", ""),
        "id_like": osr.get("ID_LIKE", ""),
        "version_id": osr.get("VERSION_ID", ""),
        "codename": osr.get("VERSION_CODENAME", ""),
        "debian_codename": osr.get("DEBIAN_CODENAME", "") or osr.get("VERSION_CODENAME", ""),
        "debian_version": read_file("/etc/debian_version").strip(),
        "branch": "unknown",
        "is_lmde": False,
        "is_debian_family": False,
        "has_apt": shutil.which("apt-get") is not None,
    }
    info["is_debian_family"] = info["id"] == "debian" or "debian" in info["id_like"].split()
    info["is_lmde"] = info["id"] == "linuxmint" and bool(osr.get("DEBIAN_CODENAME"))

    codename = info["debian_codename"]
    rolling = info["id"] == "debian" and ("sid" in info["debian_version"] or not info["version_id"])
    if rolling:
        suites = official_debian_suites()
        if suites & {"sid", "unstable"}:
            info["branch"], info["debian_codename"] = "sid", "sid"
        else:
            info["branch"] = "testing"
            if not codename or codename == "sid":
                info["debian_codename"] = TESTING_CODENAME
    elif codename == STABLE_CODENAME:
        info["branch"] = "stable"
    elif codename == OLDSTABLE_CODENAME:
        info["branch"] = "oldstable"
    elif codename == OLDOLDSTABLE_CODENAME:
        info["branch"] = "oldoldstable"
    elif codename == TESTING_CODENAME:
        info["branch"] = "testing"

    dc = info["debian_codename"]
    info["repo_codename"] = dc if dc in THIRD_PARTY_CODENAMES else STABLE_CODENAME
    info["debian_number"] = DEBIAN_RELEASES.get(dc, "")
    info["arch"] = run_cmd(["dpkg", "--print-architecture"]) or "amd64"
    return info


def branch_badge(info):
    if info["is_lmde"]:
        num = DEBIAN_RELEASES.get(info["debian_codename"], "?")
        return f"{info['pretty']}  ·  based on Debian {num} ({info['debian_codename']})"
    if info["id"] == "debian":
        label = BRANCH_LABEL.get(info["branch"], "Unknown")
        if info["branch"] == "sid":
            return "Debian sid  ·  Unstable"
        num = info["debian_number"]
        return f"Debian {num} ({info['debian_codename']})  ·  {label}".replace("Debian  (", "Debian (")
    return info["pretty"]


def secure_boot_enabled():
    for path in glob.glob("/sys/firmware/efi/efivars/SecureBoot-*"):
        try:
            with open(path, "rb") as fh:
                return fh.read()[-1] == 1
        except Exception:
            return False
    return False


def cpu_x86_level():
    """Return the x86-64 micro-architecture level (1-4), or 0 if not x86-64."""
    flags = set()
    for line in read_file("/proc/cpuinfo").splitlines():
        if line.startswith("flags"):
            flags = set(line.split(":", 1)[1].split())
            break
    if not flags or "lm" not in flags:
        return 0
    v2 = {"cx16", "lahf_lm", "popcnt", "sse4_1", "sse4_2", "ssse3"}
    v3 = {"avx", "avx2", "bmi1", "bmi2", "f16c", "fma", "abm", "movbe", "xsave"}
    v4 = {"avx512f", "avx512bw", "avx512cd", "avx512dq", "avx512vl"}
    level = 1
    if v2 <= flags:
        level = 2
        if v3 <= flags:
            level = 3
            if v4 <= flags:
                level = 4
    return level


def target_user():
    """The desktop user, even if the GUI itself was started through sudo."""
    name = os.environ.get("SUDO_USER") or os.environ.get("PKEXEC_UID") or getpass.getuser()
    try:
        if name.isdigit():
            entry = pwd.getpwuid(int(name))
        else:
            entry = pwd.getpwnam(name)
        return entry.pw_name, entry.pw_dir
    except Exception:
        return getpass.getuser(), os.path.expanduser("~")


def human_size(num):
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if num < 1024 or unit == "TB":
            return f"{num:.0f} {unit}" if unit == "B" else f"{num:.1f} {unit}"
        num /= 1024.0
    return f"{num:.1f} TB"


def dir_size(path):
    total = 0
    for base, _dirs, files in os.walk(path, onerror=lambda e: None):
        for f in files:
            try:
                total += os.lstat(os.path.join(base, f)).st_size
            except OSError:
                pass
    return total


def installed_packages():
    out = run_cmd(["dpkg-query", "-W", "-f=${Package}\t${db:Status-Abbrev}\n"], timeout=20)
    return {line.split("\t")[0] for line in out.splitlines() if "\t" in line and line.split("\t")[1].startswith("ii")}


def installed_flatpaks():
    if not shutil.which("flatpak"):
        return set()
    return set(run_cmd(["flatpak", "list", "--app", "--columns=application"], timeout=20).split())


# ---------------------------------------------------------------------------
# Startup health monitor (runs without a GUI)
# ---------------------------------------------------------------------------
def startup_health_check():
    def notify(urgency, msg):
        if shutil.which("notify-send"):
            subprocess.run(["notify-send", "-u", urgency, "-i", ICON_PATH, APP_NAME, msg])

    if run_cmd(["dpkg", "--audit"], timeout=30):
        notify("critical", "Broken or half-configured packages detected. Open Debos - Toolbox > Repair APT & Keys.")
    sim = run_cmd(["apt-get", "-s", "-o", "Debug::NoLocking=1", "dist-upgrade"], timeout=60)
    count = sum(1 for line in sim.splitlines() if line.startswith("Inst "))
    if count:
        notify("normal", f"{count} package update(s) available. Open Debos - Toolbox > Updates & Release.")
    usage = shutil.disk_usage("/")
    if usage.free < 2 * 1024 ** 3:
        notify("critical", f"Low disk space on / ({human_size(usage.free)} free). Run Clean System.")


