#!/usr/bin/python3
"""Debos - Toolbox launcher."""
import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
for candidate in (os.path.join(HERE, "..", "lib", "debos-toolbox"), "/usr/lib/debos-toolbox"):
    if os.path.isdir(os.path.join(candidate, "debos")):
        sys.path.insert(0, os.path.abspath(candidate))
        break

from debos.main import main  # noqa: E402

sys.exit(main(sys.argv))
