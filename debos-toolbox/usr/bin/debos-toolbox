                "step 'Held packages'", "apt-mark showhold", "step 'Packages not from a configured repository'",
                "apt list --installed 2>/dev/null | grep -E ',local\\]|\\[installed,local\\]' || ok 'None'"])),
            ("Open Terminal as Root", lambda: self.run_root("Root shell", ["warn 'You are root. Type exit to close.'", "bash -i"], pause=False)),
        ])

    def apply_tweaks(self):
        v = {k: var.get() for k, var in self.tw_vars.items()}
        if not any(v.values()):
            return messagebox.showinfo(APP_NAME, self.t("nothing_selected"))
        cmds = ["apt_update"]
        if v["zram"]:
            cmds += ["step 'Enabling ZRAM'", "apt_install zram-tools",
                     "printf 'ALGO=zstd\\nPERCENT=50\\nPRIORITY=100\\n' > /etc/default/zramswap", "systemctl restart zramswap", "swapon --show"]
        if v["swappiness"]:
            cmds += ["step 'Setting swappiness to 10'", "echo 'vm.swappiness=10' > /etc/sysctl.d/99-debos.conf", "sysctl -p /etc/sysctl.d/99-debos.conf"]
        if v["unattended"]:
            cmds += ["step 'Enabling unattended security upgrades'",
                     "[ \"$BRANCH\" = sid ] && warn 'Sid has no separate security archive; unattended-upgrades will only apply regular updates if configured.'",
                     "apt_install unattended-upgrades apt-listchanges",
                     "echo 'unattended-upgrades unattended-upgrades/enable_auto_updates boolean true' | debconf-set-selections",
                     "DEBIAN_FRONTEND=noninteractive dpkg-reconfigure -f noninteractive unattended-upgrades",
                     "systemctl enable --now unattended-upgrades"]
        if v["fstrim"]:
            cmds += ["step 'Enabling weekly TRIM'", "systemctl enable --now fstrim.timer"]
        if v["earlyoom"]:
            cmds += ["step 'Installing earlyoom'", "apt_install earlyoom", "systemctl enable --now earlyoom"]
        if v["tlp"]:
            cmds += ["step 'Installing TLP'", "apt_install tlp tlp-rdw", "systemctl enable --now tlp"]
        if v["timeshift"]:
            cmds += ["step 'Installing Timeshift'", "apt_install timeshift"]
        if v["flathub"]:
            cmds += self.flatpak_setup_cmds(store_plugin=True)
        if v["fonts"]:
            cmds += ["step 'Installing fonts'", "apt_install fonts-noto fonts-noto-color-emoji fonts-liberation2 fonts-firacode fonts-dejavu", "fc-cache -f"]
        if v["msfonts"]:
            cmds += ["step 'Installing Microsoft core fonts'", "enable_components", "apt_update", "apt_install ttf-mscorefonts-installer"]
        if v["essentials"]:
            cmds += ["step 'Installing essential tools'", "apt_install curl wget git htop unzip p7zip-full bash-completion",
                     "apt_install fastfetch 2>/dev/null || apt_install neofetch || true"]
        if v["archive"]:
            cmds += ["step 'Installing archive support'", "apt_install 7zip zip unzip xz-utils zstd || apt_install p7zip-full zip unzip",
                     "enable_components", "apt_update", "apt_install unrar || true"]
        if v["sudo_user"]:
            cmds += ["step 'Adding user to sudo group'", "usermod -aG sudo \"$TARGET_USER\" && ok \"$TARGET_USER added to sudo. Log out and back in.\""]
        self.run_root("Tweaks & Tools", cmds)

    # =======================================================================
    # Customizer: GRUB, Plymouth, login screen
