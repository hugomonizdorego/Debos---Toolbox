#!/bin/bash
# debos-root SCRIPT
#
# Entry point for running a Debos - Toolbox task as root (via pkexec, sudo or
# su).  It only accepts task scripts generated by the GUI: regular files named
# task-*.sh, owned by the calling user, not writable by group/others and
# stored in that user's private Debos runtime directory.  Output is recorded
# in /var/log/debos-toolbox/tasks.log.

set -u
script="${1:-}"
caller="${PKEXEC_UID:-${SUDO_UID:-${DEBOS_UID:-}}}"

refuse() {
    echo "debos-root: refusing to run '$script': $1" >&2
    exit 2
}

[ "$(id -u)" -eq 0 ] || refuse "must be started as root"
[ -n "$script" ] || refuse "no script given"
[ -f "$script" ] && [ ! -L "$script" ] || refuse "not a regular file"
case "$(basename "$script")" in
    task-*.sh) ;;
    *) refuse "unexpected file name" ;;
esac
dir="$(dirname "$script")"
case "$dir" in
    /run/user/*/debos-toolbox|/tmp/debos-toolbox-*) ;;
    *) refuse "unexpected location" ;;
esac
owner="$(stat -c %u "$script")"
perm="$(stat -c %a "$script")"
dir_owner="$(stat -c %u "$dir")"
dir_perm="$(stat -c %a "$dir")"
if [ -n "$caller" ]; then
    [ "$owner" = "$caller" ] || refuse "owned by uid $owner, expected $caller"
    [ "$dir_owner" = "$caller" ] || refuse "directory owned by uid $dir_owner"
fi
[ $((8#$perm & 8#022)) -eq 0 ] || refuse "writable by group or others"
[ $((8#$dir_perm & 8#077)) -eq 0 ] || refuse "directory is not private"

export DEBOS_LOG=/var/log/debos-toolbox/tasks.log
mkdir -p /var/log/debos-toolbox
chmod 0750 /var/log/debos-toolbox 2>/dev/null
cd / || exit 2

# Record the session with script(1) so interactive programs keep a real tty.
if command -v script >/dev/null 2>&1 && [ -t 1 ]; then
    exec script -q -e -f -a -c "/bin/bash $(printf '%q' "$script")" "$DEBOS_LOG"
fi
exec /bin/bash "$script"
